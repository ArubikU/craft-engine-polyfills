{
  "name": "warps",
  "aliases": ["pwarps", "playerwarps"],
  "description": "Browse, create, and manage player warps",
  "subcommands": [
    { "name": "buyslot", "description": "Spend XP to unlock an extra warp slot", "execute": "warps.pf:buy_extra_slot" },
    { "name": "create", "description": "Create a warp at your current location",
      "args": [{ "name": "name", "type": "greedy_string", "suggest": "warps.pf:owned_warp_names" }],
      "execute": "warps.pf:on_create_command" },
    { "name": "set", "description": "Create a warp, or move one of your own existing warps here",
      "args": [{ "name": "name", "type": "greedy_string", "suggest": "warps.pf:owned_warp_names" }],
      "execute": "warps.pf:on_set_command" },
    { "name": "help", "description": "List /warps commands", "execute": "warps.pf:cmd_help" },
    { "name": "remove", "description": "Delete one of your warps",
      "args": [{ "name": "name", "type": "string", "suggest": "warps.pf:owned_warp_names" }],
      "execute": "warps.pf:cmd_remove" },
    { "name": "desc", "description": "Manage a warp's description", "subcommands": [
      { "name": "set", "args": [
          { "name": "name", "type": "string", "suggest": "warps.pf:owned_warp_names" },
          { "name": "text", "type": "greedy_string" }],
        "execute": "warps.pf:cmd_desc_set" },
      { "name": "remove", "args": [{ "name": "name", "type": "string", "suggest": "warps.pf:owned_warp_names" }],
        "execute": "warps.pf:cmd_desc_remove" }
    ]},
    { "name": "list", "description": "List your own warps", "execute": "warps.pf:cmd_list" },
    { "name": "listof", "description": "List another player's warps",
      "args": [{ "name": "player", "type": "player" }], "execute": "warps.pf:cmd_listof" },
    { "name": "amount", "description": "Check your warp count/limit", "execute": "warps.pf:cmd_amount" },
    { "name": "amountof", "description": "Check another player's warp count",
      "args": [{ "name": "player", "type": "player" }], "execute": "warps.pf:cmd_amountof" },
    { "name": "icon", "description": "Manage a warp's icon", "subcommands": [
      { "name": "set", "args": [{ "name": "name", "type": "string", "suggest": "warps.pf:owned_warp_names" }],
        "execute": "warps.pf:cmd_icon_set" },
      { "name": "remove", "args": [{ "name": "name", "type": "string", "suggest": "warps.pf:owned_warp_names" }],
        "execute": "warps.pf:cmd_icon_remove" }
    ]},
    { "name": "category", "description": "Manage a warp's category", "subcommands": [
      { "name": "set", "args": [
          { "name": "name", "type": "string", "suggest": "warps.pf:owned_warp_names" },
          { "name": "category", "type": "string", "choices": ["houses","shops","farms","pvp","other","event"] }],
        "execute": "warps.pf:cmd_category_set" },
      { "name": "remove", "args": [{ "name": "name", "type": "string", "suggest": "warps.pf:owned_warp_names" }],
        "execute": "warps.pf:cmd_category_remove" }
    ]},
    { "name": "rate", "description": "Rate a warp 0-5 stars", "args": [
        { "name": "name", "type": "string", "suggest": "warps.pf:all_warp_names" },
        { "name": "stars", "type": "integer" }],
      "execute": "warps.pf:cmd_rate" },
    { "name": "lock", "description": "Toggle whether a warp is public or hidden",
      "args": [{ "name": "name", "type": "string", "suggest": "warps.pf:owned_warp_names" }],
      "execute": "warps.pf:cmd_lock" },
    { "name": "reset", "description": "Move a warp to your current location",
      "args": [{ "name": "name", "type": "string", "suggest": "warps.pf:owned_warp_names" }],
      "execute": "warps.pf:cmd_reset" },
    { "name": "rename", "description": "Rename a warp", "args": [
        { "name": "name", "type": "string", "suggest": "warps.pf:owned_warp_names" },
        { "name": "new_name", "type": "greedy_string" }],
      "execute": "warps.pf:cmd_rename" },
    { "name": "setowner", "description": "Transfer a warp's ownership", "args": [
        { "name": "name", "type": "string", "suggest": "warps.pf:owned_warp_names" },
        { "name": "player", "type": "player" }],
      "execute": "warps.pf:cmd_setowner" },
    { "name": "ban", "description": "Manage a warp's ban list", "subcommands": [
      { "name": "set", "args": [
          { "name": "name", "type": "string", "suggest": "warps.pf:owned_warp_names" },
          { "name": "player", "type": "player" }],
        "execute": "warps.pf:cmd_ban_set" },
      { "name": "remove", "args": [
          { "name": "name", "type": "string", "suggest": "warps.pf:owned_warp_names" },
          { "name": "player", "type": "string" }],
        "execute": "warps.pf:cmd_ban_remove" }
    ]},
    { "name": "favourite", "description": "Toggle a warp as favourite",
      "args": [{ "name": "name", "type": "string", "suggest": "warps.pf:all_warp_names" }],
      "execute": "warps.pf:cmd_favourite" },
    { "name": "removeall", "description": "(admin) Delete every warp a player owns", "permission": "polyfills.warps.admin.removeall",
      "args": [{ "name": "player", "type": "string" }], "execute": "warps.pf:cmd_removeall" },
    { "name": "reload", "description": "(admin) Reload warps scripts/commands", "permission": "polyfills.warps.admin.reload",
      "execute": "warps.pf:cmd_reload" },
    { "name": "addwarps", "description": "(admin) Grant a player extra warp slots", "permission": "polyfills.warps.admin.addwarps",
      "args": [
        { "name": "player", "type": "player" },
        { "name": "amount", "type": "integer" }],
      "execute": "warps.pf:cmd_addwarps" }
  ],
