      "when": "running",
      "run": "crusher"
    },
    {
      "type": "particle",
      "particle": "SMOKE_NORMAL",
      "count": "smoke_count",
      "location": [0.5, 1.2, 0.5],
      "spread_x": "0.15",
      "spread_y": "0.05",
      "spread_z": "0.15",
      "interval": 3,
      "when": "running",
      "run": "crusher"
    },
    {
      "type": "particle",
      "particle": "CRIT",
      "count": "1",
      "location": { "x": 0.5, "y": "1.0 + pulse_y", "z": 0.5 },
      "interval": 4,
      "when": "running && overclock > 1.5",
      "run": "crusher"
    }
  ],
  "variables": {
    "running": "processing && rpm > 0",
    "speed_mult": "max(0.05, overclock)"
