                                { "attribute": "polyfill:fuel_efficiency", "operation": "add", "value": 0.15 }],
        "cml:upgrade_scrapped":[{ "attribute": "polyfill:overclock_limit", "operation": "add", "value": 1.0  },
                                { "attribute": "polyfill:fuel_efficiency", "operation": "add", "value": -0.40 }],
        "cml:upgrade_copper":  [{ "attribute": "polyfill:overclock_limit", "operation": "add", "value": 1.0  },
                                { "attribute": "polyfill:fuel_efficiency", "operation": "add", "value": -0.40 }]
      }
    }
