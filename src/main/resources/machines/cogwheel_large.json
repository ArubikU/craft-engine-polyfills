{
  "id": "polyfills:cogwheel_large",
  "title": "Large Cogwheel",
  "menu_size": 9,
  "flags": {
    "recipes": false,
    "fuel": false,
    "ui": false,
    "ui_tick": false,
    "kinetics": true
  },
  "action_script": "cogwheel.pf:tick_large",
  "status": "cogwheel.pf:status",
  "on_break": "cogwheel.pf:on_break",
  "action_interval": 2,
  "io": {
    "rpm": {
      "input": [
        "axis_pos",
        "axis_neg"
      ],
      "output_same": [
        "axis_pos",
        "axis_neg"
      ]
    }
  },
  "renderers": [
    {
      "type": "item_display",
      "item": "CraftEngineItem(\"cml:cogwheel_large_render\")",
      "location": {
        "x": 0,
        "y": 0.5,
        "z": 0
      },
      "rot_y": "tick() * rpm * 0.3 * -1",
      "scale": "1.0",
      "when": "Machine.axis == \"y\" && Machine.activated",
      "update_when": "always",
      "global": true
    },
    {
      "type": "item_display",
      "item": "CraftEngineItem(\"cml:cogwheel_large_render\")",
      "location": {
        "x": 0,
        "y": 0.5,
        "z": 0
      },
      "rot_z": "90",
      "rot_x": "tick() * rpm * 0.3",
      "rot_y": -90,
      "scale": "1.0",
      "when": "Machine.axis == \"z\" && Machine.activated",
      "update_when": "always",
      "global": true
    },
    {
      "type": "item_display",
      "item": "CraftEngineItem(\"cml:cogwheel_large_render\")",
      "location": {
        "x": 0,
        "y": 0.5,
        "z": 0
      },
      "rot_z": "90",
      "rot_x": "tick() * rpm * 0.3",
      "scale": "1.0",
      "when": "Machine.axis == \"x\" && Machine.activated",
      "update_when": "always",
      "global": true
    }
  ]
}
