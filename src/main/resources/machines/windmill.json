{
  "id": "polyfills:windmill",
  "title": "Windmill Bearing",
  "menu_size": 9,
  "flags": {
    "recipes": false,
    "fuel": false,
    "ui": false,
    "ui_tick": false,
    "kinetics": true
  },
  "action_script": "windmill",
  "status": "windmill.pf:status",
  "on_break": "windmill.pf:on_break",
  "action_interval": 1,
  "on_right_click": "windmill_interact",
  "io": {
    "rpm": {
      "output_same": [
        "back"
      ],
      "input": []
    }
  },
  "renderers": [
    {
      "type": "item_display",
      "item": "CraftEngineItem(\"cml:windmill_bearing_head_render\")",
      "location": { "x": 0, "y": 0.5, "z": 0 },
      "rot_y": "Machine.get_flag(\"assembled\") > 0 ? tick() * rpm * 0.3 : 0",
      "scale": "1.0",
      "when": "Machine.facing == \"up\"",
      "update_when": "always",
      "global": true
    },
    {
      "type": "item_display",
      "item": "CraftEngineItem(\"cml:shaft_half_render\")",
      "location": {
        "x": 0,
        "y": 0,
        "z": 0
      },
      "rot_x": "180",
      "rot_y": "tick() * rpm * 0.3",
      "scale": "1.0",
      "when": "Machine.facing == \"up\"",
      "update_when": "always",
      "global": true
    },
    {
      "type": "item_display",
      "item": "CraftEngineItem(\"cml:windmill_bearing_head_render\")",
      "location": { "x": 0, "y": -0.25, "z": 0 },
      "rot_y": "Machine.get_flag(\"assembled\") > 0 ? tick() * rpm * 0.3 : 0",
      "scale": "1.0",
      "when": "Machine.facing == \"down\"",
      "update_when": "always",
      "global": true
    },
    {
      "type": "item_display",
