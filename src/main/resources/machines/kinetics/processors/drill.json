{
  "id": "polyfills:drill",
  "title": "Drill",
  "flags": {
    "kinetics": true,
    "io_pull": true,
    "renderers": true,
    "scripts": true,
    "animations": true
  },
  "action_script": "kinetics/processors/drill",
  "action_interval": 5,
  "io": {
    "input": [
      {
        "types": [
          "rpm"
        ],
        "faces": [
          "back"
        ]
      }
    ],
    "output_same": [
      {
        "types": [
          "rpm"
        ],
        "faces": []
      }
    ]
  },
  "renderers": [
    {
      "type": "item_display",
      "item": "CraftEngineItem(\"cml:drill_head_render\")",
      "location": {
        "x": 0,
        "y": 0.5,
        "z": 0
      },
      "rot_z": "-90",
      "rot_x": "tick() * (Machine.contraption != null ? Machine.contraption.rpm : rpm) * 0.3 *-1",
      "rot_y": -90,
      "scale": "1.0",
      "when": "Machine.activated && Machine.block.property(\"facing\") == \"north\"",
      "update_when": "always",
      "global": true
    },
    {
      "type": "item_display",
      "item": "CraftEngineItem(\"cml:drill_head_render\")",
      "location": {
        "x": 0,
        "y": 0.5,
        "z": 0
      },
      "rot_z": "90",
      "rot_x": "tick() * (Machine.contraption != null ? Machine.contraption.rpm : rpm) * 0.3 *-1",
      "rot_y": 90,
      "scale": "1.0",
      "when": "Machine.activated && Machine.block.property(\"facing\") == \"south\"",
      "update_when": "always",
      "global": true
    },
    {
      "type": "item_display",
      "item": "CraftEngineItem(\"cml:drill_head_render\")",
      "location": {
        "x": 0,
        "y": 0.5,
        "z": 0
      },
      "rot_z": "-90",
      "rot_x": "tick() * (Machine.contraption != null ? Machine.contraption.rpm : rpm) * 0.3 *-1",
      "scale": "1.0",
      "when": "Machine.activated && Machine.block.property(\"facing\") == \"east\"",
      "update_when": "always",
      "global": true
    },
    {
      "type": "item_display",
      "item": "CraftEngineItem(\"cml:drill_head_render\")",
      "location": {
        "x": 0,
        "y": 0.5,
        "z": 0
      },
      "rot_z": "90",
      "rot_x": "tick() * (Machine.contraption != null ? Machine.contraption.rpm : rpm) * 0.3 *-1",
      "scale": "1.0",
      "when": "Machine.activated && Machine.block.property(\"facing\") == \"west\"",
      "update_when": "always",
      "global": true
    },
    {
      "type": "item_display",
      "item": "CraftEngineItem(\"cml:drill_head_render\")",
      "location": {
        "x": 0,
        "y": 0.5,
        "z": 0
      },
      "rot_y": "tick() * (Machine.contraption != null ? Machine.contraption.rpm : rpm) * 0.3 *-1",
      "scale": "1.0",
      "when": "Machine.activated && Machine.block.property(\"facing\") == \"up\"",
      "update_when": "always",
      "global": true
    },
    {
      "type": "item_display",
      "item": "CraftEngineItem(\"cml:drill_head_render\")",
      "location": {
        "x": 0,
        "y": 0.5,
        "z": 0
      },
      "rot_y": "tick() * (Machine.contraption != null ? Machine.contraption.rpm : rpm) * 0.3 *-1",
      "scale": "1.0",
      "when": "Machine.activated && Machine.block.property(\"facing\") == \"down\"",
      "update_when": "always",
      "global": true
    }
  ]
}
