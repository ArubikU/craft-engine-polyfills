{
  "id": "polyfills:harvester",
  "title": "Harvester",
  "flags": {
    "recipes": false,
    "fuel": false,
    "ui": false,
    "ui_tick": false,
    "continuous_fuel": false,
    "io_pull": true,
    "renderers": true,
    "scripts": true,
    "animations": true,
    "kinetics": false
  },
  "action_script": "kinetics/processors/harvester",
  "action_interval": 5,
  "renderers": [
    {
      "type": "item_display",
      "item": "CraftEngineItem(\"cml:harvester_blade_render\")",
      "location": {
        "x": 0,
        "y": 0.5,
        "z": 0
      },
      "rot_y": "180",
      "rot_x": "tick() * (Machine.contraption != null ? Machine.contraption.rpm : rpm) * 0.3 * -1",
      "scale": "0.99999",
      "when": " Machine.block.property(\"facing\") == \"north\"",
      "update_when": "always",
      "global": true
    },
    {
      "type": "item_display",
      "item": "CraftEngineItem(\"cml:harvester_blade_render\")",
      "location": {
        "x": 0,
        "y": 0.5,
        "z": 0
      },
      "rot_x": "tick() * (Machine.contraption != null ? Machine.contraption.rpm : rpm) * 0.3 * -1",
      "scale": "0.99999",
      "when": " Machine.block.property(\"facing\") == \"south\"",
      "update_when": "always",
      "global": true
    },
    {
      "type": "item_display",
      "item": "CraftEngineItem(\"cml:harvester_blade_render\")",
      "location": {
        "x": 0,
        "y": 0.5,
        "z": 0
      },
      "rot_y": "90",
      "rot_x": "tick() * (Machine.contraption != null ? Machine.contraption.rpm : rpm) * 0.3 * -1",
      "scale": "0.99999",
      "when": " Machine.block.property(\"facing\") == \"east\"",
      "update_when": "always",
      "global": true
    },
    {
      "type": "item_display",
      "item": "CraftEngineItem(\"cml:harvester_blade_render\")",
      "location": {
        "x": 0,
        "y": 0.5,
        "z": 0
      },
      "rot_y": "270",
      "rot_x": "tick() * (Machine.contraption != null ? Machine.contraption.rpm : rpm) * 0.3 * -1",
      "scale": "0.99999",
      "when": " Machine.block.property(\"facing\") == \"west\"",
      "update_when": "always",
      "global": true
    }
  ]
}
