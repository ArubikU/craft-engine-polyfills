{
  "id": "polyfills:large_water_wheel",
  "title": "Large Water Wheel",
  "menu_size": 9,
  "flags": {
    "recipes": false,
    "fuel": false,
    "ui": false,
    "ui_tick": false,
    "kinetics": true,
    "continuous_fuel": false,
    "io_pull": true,
    "renderers": true,
    "scripts": true,
    "animations": true
  },
  "action_script": "kinetics/generators/water_wheel.pf:tick_large",
  "status": "kinetics/generators/water_wheel.pf:status",
  "on_break": "kinetics/generators/water_wheel.pf:on_break",
  "action_interval": 20,
  "io": {
    "output_same": [
      {
        "types": [
          "rpm"
        ],
        "faces": [
          "axis_pos",
          "axis_neg"
        ]
      }
    ]
  },
  "renderers": [
    {
      "type": "item_display",
      "item": "CraftEngineItem(\"cml:large_water_wheel_render\")",
      "location": {
        "x": 0,
        "y": 0.5,
        "z": 0
      },
      "rot_y": "tick() * rpm * 0.3",
      "when": "Machine.axis == \"y\" && rpm != 0",
      "scale": "1.0",
      "update_when": "always",
      "global": true
    },
    {
      "type": "item_display",
      "item": "CraftEngineItem(\"cml:large_water_wheel_render\")",
      "location": {
        "x": 0,
        "y": 0.5,
        "z": 0
      },
      "rot_z": "90",
      "rot_x": "tick() * rpm * 0.3",
      "when": "Machine.axis == \"x\" && rpm != 0",
      "scale": "1.0",
      "update_when": "always",
      "global": true
    },
    {
      "type": "item_display",
      "item": "CraftEngineItem(\"cml:large_water_wheel_render\")",
      "location": {
        "x": 0,
        "y": 0.5,
        "z": 0
      },
      "rot_x": "90",
      "rot_y": "tick() * rpm * 0.3",
      "when": "Machine.axis == \"z\" && rpm != 0",
      "scale": "1.0",
      "update_when": "always",
      "global": true
    }
  ]
}
