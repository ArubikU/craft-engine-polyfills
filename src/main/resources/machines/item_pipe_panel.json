{
  "id": "polyfills:item_pipe_panel",
  "title": "Item Pipe",
  "flags": {
    "recipes": false,
    "fuel": false
  },
  "action_script": "item_pipe_panel",
  "action_interval": 1,
  "on_pipe_transfer": "item_pipe_panel.pf:filter_item",
  "pages": [
    {
      "title": "Item Pipe",
      "size": 27,
      "buttons": [
        { "slot": 0, "icon": "cml:plus_icon", "action": "script:item_pipe_panel.pf:mode_north", "name": "<gray>North — click to cycle Disabled/Input/Output" },
        { "slot": 1, "icon": "cml:plus_icon", "action": "script:item_pipe_panel.pf:mode_south", "name": "<gray>South — click to cycle Disabled/Input/Output" },
        { "slot": 2, "icon": "cml:plus_icon", "action": "script:item_pipe_panel.pf:mode_east",  "name": "<gray>East — click to cycle Disabled/Input/Output" },
        { "slot": 3, "icon": "cml:plus_icon", "action": "script:item_pipe_panel.pf:mode_west",  "name": "<gray>West — click to cycle Disabled/Input/Output" },
        { "slot": 4, "icon": "cml:plus_icon", "action": "script:item_pipe_panel.pf:mode_up",    "name": "<gray>Up — click to cycle Disabled/Input/Output" },
        { "slot": 5, "icon": "cml:plus_icon", "action": "script:item_pipe_panel.pf:mode_down",  "name": "<gray>Down — click to cycle Disabled/Input/Output" },
        { "slot": 9,  "icon": "cml:minus_icon", "action": "script:item_pipe_panel.pf:redstone_north", "name": "<gray>North — toggle redstone required" },
        { "slot": 10, "icon": "cml:minus_icon", "action": "script:item_pipe_panel.pf:redstone_south", "name": "<gray>South — toggle redstone required" },
        { "slot": 11, "icon": "cml:minus_icon", "action": "script:item_pipe_panel.pf:redstone_east",  "name": "<gray>East — toggle redstone required" },
        { "slot": 12, "icon": "cml:minus_icon", "action": "script:item_pipe_panel.pf:redstone_west",  "name": "<gray>West — toggle redstone required" },
        { "slot": 13, "icon": "cml:minus_icon", "action": "script:item_pipe_panel.pf:redstone_up",    "name": "<gray>Up — toggle redstone required" },
        { "slot": 14, "icon": "cml:minus_icon", "action": "script:item_pipe_panel.pf:redstone_down",  "name": "<gray>Down — toggle redstone required" },
        { "slot": 18, "icon": "cml:upgrade_button", "action": "script:item_pipe_panel.pf:filter_north", "name": "<yellow>North — edit item filter" },
        { "slot": 19, "icon": "cml:upgrade_button", "action": "script:item_pipe_panel.pf:filter_south", "name": "<yellow>South — edit item filter" },
        { "slot": 20, "icon": "cml:upgrade_button", "action": "script:item_pipe_panel.pf:filter_east",  "name": "<yellow>East — edit item filter" },
        { "slot": 21, "icon": "cml:upgrade_button", "action": "script:item_pipe_panel.pf:filter_west",  "name": "<yellow>West — edit item filter" },
        { "slot": 22, "icon": "cml:upgrade_button", "action": "script:item_pipe_panel.pf:filter_up",    "name": "<yellow>Up — edit item filter" },
        { "slot": 23, "icon": "cml:upgrade_button", "action": "script:item_pipe_panel.pf:filter_down",  "name": "<yellow>Down — edit item filter" }
      ]
    },
    {
      "title": "Item Filter",
      "size": 27,
      "slots": {
        "input": [0, 1, 2, 3, 4, 5, 6, 7, 8]
      },
      "buttons": [
        {
          "slot": 11,
          "icon": "cml:overclock_button",
          "action": "script:item_pipe_panel.pf:toggle_filter_whitelist",
          "name": "<gray>Toggle Whitelist / Blacklist",
          "lore": ["<dark_gray>Whitelist: only listed items pass.", "<dark_gray>Blacklist: everything EXCEPT listed items passes."]
        },
        {
          "slot": 13,
          "icon": "cml:su_up",
          "action": "script:item_pipe_panel.pf:save_filter",
          "name": "<green>Save Filter",
          "lore": ["<dark_gray>Whatever is sitting in the 9 slots above", "<dark_gray>becomes this face's filter (replaces it entirely)."]
        },
        {
          "slot": 15,
          "icon": "cml:return_icon",
          "action": "open_page:0",
          "name": "<lang:polyfill.ui.back>"
        }
      ]
    }
  ]
}
