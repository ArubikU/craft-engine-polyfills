      "rot_x": "tick() * rpm * 0.3 ",
      "scale": "1.0",
      "when": "Machine.activated",
      "update_when": "always",
      "global": true
    },
    {
      "type": "item_display",
      "item": "CraftEngineItem(\"cml:shaft_half_render\")",
      "location": {
        "x": 0,
        "y": 0.5,
        "z": 0
      },
      "rot_z": "90",
      "rot_x": "tick() * rpm * 0.3 ",
      "scale": "1.0",
