# Item Pipe Panel — keeps this segment registered in the item-pipe network engine (cheap,
# idempotent — a single map write) every tick, and implements the 6 face-mode buttons + 6
# per-face redstone-required toggles. See machines/item_pipe_panel.json for the button wiring.

Machine.pipe_register_network()


# Facing a storage container: Disabled -> Input -> Output -> Both -> Disabled (all 4 states are
# meaningful there — the pipe pulls from / pushes into an actual inventory).
# Facing another pipe (or nothing at all yet): only Disabled <-> Both makes sense — a segment
# either routes items through this face or it doesn't, there's no separate "direction" to a plain
# conduit. Cycling a pipe-facing side through Input-only/Output-only would be a state with no
# real effect (routing already only cares whether either flag is set, see ItemEngine#step's
# isConnectedTo check), so collapse it to a single toggle instead of pretending it's meaningful.
def cycle_mode(dir):
    has_in = Machine.io_get("item", "input", dir)
    has_out = Machine.io_get("item", "output", dir)
    if !Machine.neighbor_block(dir).is_container:
        if has_in && has_out:
            Machine.io_set("item", "input", dir, false)
            Machine.io_set("item", "output", dir, false)
        else:
            Machine.io_set("item", "input", dir, true)
            Machine.io_set("item", "output", dir, true)
        end
        return
    end
    if !has_in && !has_out:
        Machine.io_set("item", "input", dir, true)
    else:
        if has_in && !has_out:
            Machine.io_set("item", "input", dir, false)
            Machine.io_set("item", "output", dir, true)
        else:
            if !has_in && has_out:
                Machine.io_set("item", "input", dir, true)
            else:
                Machine.io_set("item", "input", dir, false)
                Machine.io_set("item", "output", dir, false)
            end
        end
    end
end

def toggle_redstone(dir):
    required = Machine.io_get("redstone", "input", dir)
    if required:
        Machine.io_set("redstone", "input", dir, false)
    else:
        Machine.io_set("redstone", "input", dir, true)
    end
end

def mode_north():
    cycle_mode("north")
end
def mode_south():
    cycle_mode("south")
end
def mode_east():
    cycle_mode("east")
end
def mode_west():
    cycle_mode("west")
end
def mode_up()  :
    cycle_mode("up")
end
def mode_down():
    cycle_mode("down")
end

def redstone_north():
    toggle_redstone("north")
end
def redstone_south():
    toggle_redstone("south")
end
def redstone_east():
    toggle_redstone("east")
end
def redstone_west():
    toggle_redstone("west")
end
def redstone_up()  :
    toggle_redstone("up")
end
def redstone_down():
    toggle_redstone("down")
end

# --- Item filter (page 1) ---
#
# Storage: ONE FULL ITEM flag per filter slot, "pipe_filter_<dir>_<slot 0..8>" (see
# Machine.get_item_flag/set_item_flag — a base64-serialized ItemStack, not just an id string), so
# an enchanted book, a custom-named tool, a written book etc. filter by their EXACT identity, not
# merely "any item of that base type". Not a single joined CSV — this script engine has no
# string-split builtin, so a CSV would be write-only; one flag per slot needs no parsing at all.
#
# The 9 filter slots on page 1 are GHOST slots (see MenuSlotType#GHOST / machines/item_pipe_panel
# .json's "ghost_slots"), NOT real input slots — a real, conjured-on-open marker item was the whole
# duplication bug: Machine.add_item_to_slot materialized a brand new ItemStack from the saved id
# every time the page opened, and a player who took that marker into their own inventory (a
# perfectly ordinary click on what LOOKS like a normal slot) got a real, keepable copy for free —
# repeatable indefinitely by just reopening the page. A ghost slot never holds a real, transferable
# stack at all: `ghost_get` only supplies what item to RENDER, `ghost_set` only ever READS the
# clicked item (never touches/consumes/duplicates it), and every click commits immediately — no
# separate Save step, so there's no "unsaved edit" a disconnect could ever leave in a half-done
# state. The stack's COUNT is irrelevant either way — this is an identity filter ("this slot's
# type/enchants/etc match"), not a quantity threshold, so clicking in 1 or 64 means the same thing.
def dir_name(idx):
    if idx == 0:
        return "north"
    end
    if idx == 1:
        return "south"
    end
    if idx == 2:
        return "east"
    end
    if idx == 3:
        return "west"
    end
    if idx == 4:
        return "up"
    end
    return "down"
end

def open_filter(idx):
    Machine.set_flag("pipe_filter_dir_index", idx)
    Machine.page(1)
end

def filter_north():
    open_filter(0)
end
def filter_south():
    open_filter(1)
end
def filter_east():
    open_filter(2)
end
def filter_west():
    open_filter(3)
end
def filter_up()  :
    open_filter(4)
end
def filter_down():
    open_filter(5)
end

def toggle_filter_whitelist():
    dir = dir_name(Machine.get_flag("pipe_filter_dir_index"))
    name = "pipe_whitelist_" + dir
    cur = Machine.get_flag(name)
    if cur == 0:
        Machine.set_flag(name, 1)
    else:
        Machine.set_flag(name, 0)
    end
end

# --- Filter match mode (per face) ---
#
# Named "matchmode" (not "mode") deliberately — `mode` is already bound inside filter_item() as
# the TRANSFER direction ("input"/"output", see ItemEngine#runTransferScript), a completely
# different axis; reusing the name would silently shadow it.
#
#   equals  — same item type + same components (enchants, name, ...) + same STACK COUNT too.
#   seamsly — same item type + same components, count irrelevant (the previous, only behaviour).
#   id      — only the base item type/id; ignores every component and the count.
def filter_matchmode(dir):
    m = Machine.get_str_flag("pipe_filter_matchmode_" + dir)
    if m == "":
        return "seamsly"
    end
    return m
end

def cycle_filter_matchmode():
    dir = dir_name(Machine.get_flag("pipe_filter_dir_index"))
    cur = filter_matchmode(dir)
    next = "seamsly"
    if cur == "seamsly":
        next = "id"
    end
    if cur == "id":
        next = "equals"
    end
    if cur == "equals":
        next = "seamsly"
    end
    Machine.set_str_flag("pipe_filter_matchmode_" + dir, next)
end

# Bare ".pf:func" button name (see MachineMenuConfig.Button#evaluateNameRaw) — the whole label
# lives here instead of a giant nested ${if(...)} in the JSON.
def filter_matchmode_label():
    dir = dir_name(Machine.get_flag("pipe_filter_dir_index"))
    m = filter_matchmode(dir)
    text = "Seamsly"
    if m == "id":
        text = "Id"
    end
    if m == "equals":
        text = "Equals"
    end
    return "<gray>Filter Mode: <yellow>" + text
end

# The one place that decides whether `candidate` counts as "the same" as a saved filter item —
# every filter-adjacent feature this addon grows later should call THIS, not reinvent its own
# comparison, so "what does Equals/Seamsly/Id mean" only ever has to change in one spot.
def item_matches(candidate, saved, matchmode):
    if matchmode == "id":
        return candidate.id == saved.id
    end
    if matchmode == "equals":
        return candidate.same_as(saved) && candidate.count == saved.count
    end
    return candidate.same_as(saved)
end

# Ghost slot render hook — `slot` (0..8) is bound by Java before this runs. Returning the full Item
# (rather than a bare id string) means the rendered icon shows the EXACT saved item — enchant
# glint, custom name, everything — not just a generic stand-in for its base type.
def ghost_get():
    dir = dir_name(Machine.get_flag("pipe_filter_dir_index"))
    return Machine.get_item_flag("pipe_filter_" + dir + "_" + slot)
end

# Ghost slot click hook — `slot`, `clicked_item` (the FULL cursor item, or empty if empty-handed)
# and `click_type` are bound by Java. Right-click always clears (regardless of what's in hand); a
# left-click with an item sets it (preserving every component); a left-click with an EMPTY hand is
# a no-op — otherwise just browsing an already-filled slot with nothing held would silently wipe it.
def ghost_set():
    dir = dir_name(Machine.get_flag("pipe_filter_dir_index"))
    key = "pipe_filter_" + dir + "_" + slot
    if click_type == "right" || click_type == "shift_right":
        Machine.clear_item_flag(key)
        return
    end
    if is_empty(clicked_item):
        return
    end
    Machine.set_item_flag(key, clicked_item)
end

# --- Item filter evaluation (on_pipe_transfer hook, see machines/item_pipe_panel.json) ---
# This is the SAME generic hook every machine's own transfer gate calls (AbstractMachineBlockEntity
# #runOnTransferScript) — here it's an item pipe segment's per-face filter, elsewhere it's a
# destination machine vetoing what it accepts, but it's one mechanism. Called with `type` ("item"
# for this pipe), `payload` (the candidate Item), `direction`, `mode` bound. Java only orchestrates
# the call and reads back Machine.set_flag("_transfer_cancel", …) — 1 = block, 0/unset = allow.
# Change what "passes" means by editing this function, never by touching ItemEngine.java.
def filter_item():
    if type != "item":
        return
    end
    matchmode = filter_matchmode(direction)
    listed = false
    any_filter = false
    for slot in range(0, 9):
        filter_item_at_slot = Machine.get_item_flag("pipe_filter_" + direction + "_" + slot)
        if !is_empty(filter_item_at_slot):
            any_filter = true
            if item_matches(payload, filter_item_at_slot, matchmode):
                listed = true
            end
        end
    end
    if !any_filter:
        Machine.set_flag("_transfer_cancel", 0)
        return
    end
    whitelist = Machine.get_flag("pipe_whitelist_" + direction)
    passes = listed
    if whitelist == 0:
        passes = !listed
    end
    if passes:
        Machine.set_flag("_transfer_cancel", 0)
    else:
        Machine.set_flag("_transfer_cancel", 1)
    end
end



