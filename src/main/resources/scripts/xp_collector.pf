# XP Collector — collects experience orbs and fills XP tank.

entities = Machine.nearby_entities(6)
total_xp  = 0

for entity in entities {
    if entity.type == "minecraft:experience_orb" {
        total_xp += entity.xp_value
        entity.remove()
    }
}

if total_xp > 0 {
    Machine.fill_fluid("experience", total_xp)
}
