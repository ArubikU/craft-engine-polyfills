# Pulser — timed pulse. On rising edge, outputs for N ticks then off.
duration = Machine.get_flag("duration")
if duration <= 0:
    duration = 10
end

prev = Machine.get_flag("prev_power")
cur = Machine.redstone > 0 ? 1 : 0

if cur == 1 && prev == 0:
    Machine.set_flag("countdown", duration)
end

t = Machine.get_flag("countdown")
if t > 0:
    Machine.emit_redstone(15)
    Machine.set_flag("countdown", t - 1)
else:
    Machine.emit_redstone(0)
end
Machine.set_flag("prev_power", cur)



