# Item Trash — destroys items in input slots and nearby dropped item entities.

for i in range(27) {
    if !is_empty(Machine.get_item_in_slot(i)) {
        Machine.remove_item_in_slot(i, 64)
    }
}

entities = Machine.nearby_entities(1)
for entity in entities {
    if entity.type == "minecraft:item" {
        entity.remove()
    }
}
