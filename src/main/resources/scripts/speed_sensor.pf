# Speed Sensor — measures the fastest nearby entity and outputs 0-15.
#
# Tunables, all via Machine.set_flag (values are ints):
#   scan_range   blocks to scan                        (default 3)
#   full_speed   speed meaning power 15, in hundredths
#                of a block per tick                   (default 50 = 0.50 blocks/tick)
#   deadzone     speed below this reads 0, same units  (default 10 = 0.10 blocks/tick)
#   living_only  1 = ignore items/projectiles/xp orbs  (default 0)
#   count_y      1 = include vertical speed            (default 0 = horizontal only)
#
# Two things this fixes:
#
# 1. Scale. The old version hardcoded "1.0 blocks/tick = 15", but a sprinting player only moves
#    about 0.28 blocks/tick, so the sensor never read above ~4 and most of its range was dead.
#
# 2. Idle noise. A standing entity is NOT at rest: gravity keeps its vertical velocity pinned
#    near -0.0784 every tick, so a naive magnitude read reported 1-2 for a player standing
#    perfectly still. Vertical motion is therefore excluded by default, and a deadzone drops
#    whatever jitter remains.

scan_range = Machine.get_flag("scan_range")
if scan_range <= 0 { scan_range = 3 }

full_speed = Machine.get_flag("full_speed")
if full_speed <= 0 { full_speed = 50 }
full = full_speed / 100.0

deadzone = Machine.get_flag("deadzone")
if deadzone <= 0 { deadzone = 10 }
dead = deadzone / 100.0

living_only = Machine.get_flag("living_only")
count_y     = Machine.get_flag("count_y")

entities = Machine.nearby_entities(scan_range)
max_speed = 0

for entity in entities {
    if living_only > 0 && !entity.is_living { continue }
    vx = entity.velocity_x
    vy = count_y > 0 ? entity.velocity_y : 0
    vz = entity.velocity_z
    speed = sqrt(vx * vx + vy * vy + vz * vz)
    if speed > max_speed { max_speed = speed }
}

power = 0
if max_speed > dead {
    # Rescale so the deadzone edge is 1, not a jump straight to mid-range.
    power = clamp(round((max_speed - dead) / max(full - dead, 0.01) * 15), 1, 15)
}
Machine.redstone.set(power)
