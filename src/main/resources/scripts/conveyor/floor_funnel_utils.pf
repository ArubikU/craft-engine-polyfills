# Floor Funnel / Ceiling Funnel - shared tick, mirroring the old FloorFunnelBlockEntity Java
# behavior 1:1 (both variants were literally the same Java class, `pull_above` was its only
# constructor difference). No animation, no facing - always straight up/down, one item held at a
# time, instant pickup/drop (unlike the belt-facing Funnel, which travels over FUNNEL_STEP ticks).
#
# Floor funnel (pull_above=false): vacuums dropped items resting on top, deposits into the
# container below each tick (drops instead if nothing's there to deposit into).
# Ceiling funnel (pull_above=true): vacuums dropped items AND actively pulls from a container
# above, always just drops below - it never deposits into one (matches real Create funnels: a
# ceiling funnel gravity-feeds, it doesn't insert).

import "utils.pf" { is_resting_item }

def _floor_funnel_vacuum():
    for entity in Machine.nearby_entities(0.7):
        if is_resting_item(entity) && entity.pos.y >= Machine.y:
            item = entity.item
            entity.remove()
            return item
        end
    end
    return Item.create("minecraft:air")
end

def _floor_funnel_tick(pull_above):
    held = Machine.container.get_item(0)
    if is_empty(held):
        held = _floor_funnel_vacuum()
        if is_empty(held) && pull_above:
            above = Machine.container_at(0, 1, 0)
            if above != null:
                held = above.pull(64)
            end
        end
        if !is_empty(held):
            Machine.container.set_item(0, held)
        end
    end

    held = Machine.container.get_item(0)
    if is_empty(held):
        return
    end

    if pull_above:
        Machine.drop_item_at(held, 0, -1, 0)
        Machine.container.set_item(0, null)
        return
    end

    below = Machine.container_at(0, -1, 0)
    if below != null:
        leftover = below.push(held)
        if is_empty(leftover):
            Machine.container.set_item(0, null)
        else if item_count(leftover) < item_count(held):
            Machine.container.set_item(0, leftover)
        end
        return
    end
    Machine.drop_item_at(held, 0, -1, 0)
    Machine.container.set_item(0, null)
end

def _floor_funnel_drop_held():
    held = Machine.container.get_item(0)
    if !is_empty(held):
        Machine.drop_item(held)
        Machine.container.set_item(0, null)
    end
end

# Empty-hand right-click takes the held item back into the player's inventory - matches
# FloorFunnelBehavior/CeilingFunnelBehavior's own useWithoutItem exactly (non-empty hand passes
# through, e.g. so a player can still place a block against it).
def _floor_funnel_on_right_click():
    if !is_empty(Player.main_hand):
        return
    end
    held = Machine.container.get_item(0)
    if is_empty(held):
        return
    end
    Player.give_item(held)
    Machine.container.set_item(0, null)
end
