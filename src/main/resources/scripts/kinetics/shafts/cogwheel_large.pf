# Large Cogwheel
# Shaft (axis_pos/axis_neg): set_rpm_output propagates via IO.
# Gear mesh (axis_perp): relay_to each adjacent small cog, same axis, 2x inverted.
# large->large: INVALID, skip. large->small: 2x speed.
import "kinetics/utils.pf" { _update_activated }

Machine.set_rpm_output(rpm)

axis = Machine.axis
if axis == null:
    return
end

net = Machine.rpm_network

if axis == "y":
    perp = [ Machine.block_at(1,0,0), Machine.block_at(-1,0,0), Machine.block_at(0,0,1), Machine.block_at(0,0,-1) ]
else if axis == "x":
    perp = [ Machine.block_at(0,1,0), Machine.block_at(0,-1,0), Machine.block_at(0,0,1), Machine.block_at(0,0,-1) ]
else:
    perp = [ Machine.block_at(1,0,0), Machine.block_at(-1,0,0), Machine.block_at(0,1,0), Machine.block_at(0,-1,0) ]
end

for neighbor in perp:
    if neighbor.property("axis") != axis:
        continue
    end
    nid = neighbor.id
    if contains(nid, "cogwheel_small") && !contains(nid, "large"):
        Machine.relay_to(neighbor, -rpm * 2.0, net)
    end
    # large->large: invalid, skip
end

is_now = rpm != 0 ? 1 : 0
_update_activated("_cog_act", is_now)

def on_break():
    Machine.set_rpm_output(0)
    Machine.report_su(0)
end



