# Rotational Bearing - tick script. The opposite of the Windmill Bearing: instead of GENERATING
# rpm/su from sails, this bearing CONSUMES rpm/su fed into it from below and uses that rpm to spin
# whatever glued structure is attached to its face - Create's actual Mechanical Bearing, as opposed
# to the Windmill Bearing's self-powered one.
#
# Direction follows the incoming network's sign directly (no manual flip like windmill_dir - the
# network already encodes which way it's turning, there's no ambiguity to resolve here).
#
# SU cost: floor(contraption.weight / 5) - a heavier attached structure costs more network capacity
# to keep turning, same idea as Create's stress-per-block for a rotating attachment. `weight` sums
# WeightBlockBehavior.weightOf() over every block in the structure (see ContraptionType#weight).

# Advances the SAME persisted angle the head-cap renderer reads (Machine.get_typed("head_angle", "int"))
# by exactly the amount contraption.set_spin() just advanced the real contraption's rotation -
# same elapsed-real-ticks-since-last-call approach, same rpm value, same "1 RPM = 0.3 deg/tick"
# constant. This replaces an earlier attempt that had the RENDERER recompute an angle from
# "tick() - assembled_tick" (ticks since assembly) times the CURRENT rpm - correct only if rpm
# had been constant literally since assembly, which breaks after any speed change (this bearing's
# rpm follows a live network, so that's the common case, not an edge case), not just after a
# restart. Accumulating here, the same way the contraption itself does, stays correct through rpm
# changes AND survives a restart for free: elapsed = clamp(now-last, 0, 100) already floors to 0
# when `now` resets below the old absolute `last` tick.
def _advance_head_angle(rpm_value):
    last = Machine.get_typed("head_last_tick", "int")
    now = tick()
    if last <= 0:
        last = now
    end
    elapsed = clamp(now - last, 0, 100)
    Machine.set_typed("head_angle", "int", Machine.get_typed("head_angle", "int") + elapsed * rpm_value * 0.3)
    Machine.set_typed("head_last_tick", "int", now)
end

def _stop():
    Machine.report_su(0)
    _advance_head_angle(0)
end

# The world axis the bearing turns about: the axis it FACES (same as windmill.pf's _spin_axis -
# a bearing on the ground faces up and turns flat (Y); one on a wall turns like a wheel (X or Z)).
def _spin_axis():
    if Machine.facing_dy != 0:
        return "y"
    end
    if Machine.facing_dx != 0:
        return "x"
    end
    return "z"
end

def status():
    return Machine.get_typed("assembled", "int") > 0 && rpm != 0 ? "true" : "false"
end

def on_break():
    _stop()
end

# ---- tick ---------------------------------------------------------------

if Machine.get_typed("assembled", "int") <= 0:
    _stop()
    return
end

contraption = Machine.contraption

if contraption == null:
    # The contraption is gone (broken, unloaded past recovery): forget it and stop.
    Machine.set_typed("assembled", "int", 0)
    Machine.set_typed("contraption_uuid", "string", "")
    _stop()
    return
end

if rpm == 0:
    # Nothing feeding the bearing right now - hold still, don't charge for it.
    contraption.set_spin(_spin_axis(), 0)
    _stop()
    return
end

su = floor(contraption.weight / 5)

if Machine.is_overstressed:
    # The network can't actually cover this load: stall instead of spinning for free.
    contraption.set_spin(_spin_axis(), 0)
    Machine.report_su(su)
    _advance_head_angle(0)
    return
end

contraption.set_spin(_spin_axis(), rpm)
Machine.report_su(su)
_advance_head_angle(rpm)
