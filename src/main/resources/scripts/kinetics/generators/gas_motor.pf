# Gas Motor — full logic matching the original DataMotorBlockEntity behavior.
# Reads gas from "vapor" tank, calculates RPM/SU based on gas type,
# applies overclock multiplier, reports SU to RpmNetwork.

# ---- Function definitions FIRST (before any return) ----

def increase_rpm(amount):
    cur = Machine.get_typed("target_rpm", "int")
    if cur <= 0:
        cur = 32
    end
    new_val = min(cur + num(amount), 512)
    Machine.set_typed("target_rpm", "int", new_val)
    cur_su = Machine.get_typed("target_su", "int")
    if cur_su <= 0:
        cur_su = 64
    end
    Machine.set_typed("target_su", "int", floor(cur_su * new_val / cur))
end

def decrease_rpm(amount):
    cur = Machine.get_typed("target_rpm", "int")
    if cur <= 0:
        cur = 32
    end
    new_val = max(cur - num(amount), 0)
    Machine.set_typed("target_rpm", "int", new_val)
    if new_val == 0:
        Machine.set_typed("target_su", "int", 0)
    else:
        cur_su = Machine.get_typed("target_su", "int")
        if cur_su <= 0:
            cur_su = 64
        end
        Machine.set_typed("target_su", "int", floor(cur_su * new_val / cur))
    end
end

def increase_su(amount):
    cur = Machine.get_typed("target_su", "int")
    if cur <= 0:
        cur = 64
    end
    new_val = min(cur + num(amount), 1024)
    Machine.set_typed("target_su", "int", new_val)
end

def decrease_su(amount):
    cur = Machine.get_typed("target_su", "int")
    if cur <= 0:
        cur = 64
    end
    new_val = max(cur - num(amount), 0)
    Machine.set_typed("target_su", "int", new_val)
end

def status():
    tanks = Machine.gas_tanks
    if tanks.length <= 0:
        return "false"
    end
    tank = tanks.get(0)
    if tank.get("is_empty"):
        return "false"
    end
    t_rpm = Machine.get_typed("target_rpm", "int")
    if t_rpm <= 0:
        return "false"
    end
    return "true"
end

def on_break():
    Machine.set_rpm_output(0)
    Machine.report_su(0)
end

# ---- Gas type specs (gas_id -> {base_rpm, base_su, per_tick}) ----
GAS_SPECS = make_map(
"polyfills:steam",       make_map("rpm", 32, "su", 64,  "per_tick", 10),
"polyfills:heavy_steam", make_map("rpm", 64, "su", 128, "per_tick", 15)
)

# ---- Read player-set targets (default if never set) ----
target_rpm = Machine.get_typed("target_rpm", "int")
target_su  = Machine.get_typed("target_su", "int")

# ---- Check gas tank ----
gas_tanks = Machine.gas_tanks
if gas_tanks.length <= 0:
    Machine.set_rpm_output(0)
    Machine.report_su(0)
    return
end

tank = gas_tanks.get(0)
gas_level = tank.get("level")
gas_id    = ""
spec = null

# Find spec for current gas type
if !tank.get("is_empty"):
    gas_id = tank.get("contents_key")
    spec = GAS_SPECS.get(gas_id)
end

if spec == null || gas_level <= 0:
    Machine.set_rpm_output(0)
    Machine.report_su(0)
    return
end

# ---- Get base values from spec ----
base_rpm      = spec.get("rpm")
base_su       = spec.get("su")
base_per_tick = spec.get("per_tick")

# ---- Set defaults from spec if not yet configured ----
if target_rpm <= 0:
    target_rpm = base_rpm
    Machine.set_typed("target_rpm", "int", target_rpm)
end
if target_su <= 0:
    target_su = base_su
    Machine.set_typed("target_su", "int", target_su)
end

# ---- Apply overclock ----
oc_factor = 1.0 + Machine.overclock
eff_rpm = target_rpm * oc_factor
eff_su  = target_su * oc_factor

# ---- Gas consumption = base_per_tick * (rpm_ratio) * oc * (1 - efficiency) ----
rpm_ratio = target_rpm / base_rpm
consume_per_tick = floor(base_per_tick * rpm_ratio * oc_factor * (1.0 - Machine.efficiency))
consume_per_tick = max(1, consume_per_tick)

if Machine.is_overstressed:
    Machine.set_rpm_output(0)
    Machine.report_su(-eff_su)
else:
    Machine.set_rpm_output(eff_rpm)
    Machine.report_su(-eff_su)
    Machine.consume_gas("vapor", consume_per_tick)
end



