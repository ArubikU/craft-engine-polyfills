# Windmill Bearing — tick script, ported from Create's WindmillBearingBlockEntity.
#
#   int sails = sailBlocks / windmillSailsPerRPM;      // config default 8
#   return Mth.clamp(sails, 1, 16) * direction;        // 1..16 RPM
#
# Two things the previous version got wrong:
#
#  * It read the sails through `contraption.contraption_world.blocks()`. ContraptionWorld has no
#    blocks() — that lives on Contraption itself — so the call returned null, the loop never ran,
#    the sail count stayed 0 and the windmill produced NO rpm at all, ever.
#  * It used `sail_count * 8` unclamped. Create divides BY 8 and caps at 16, so eight sails give
#    1 rpm, not 64.

SAILS_PER_RPM = 8      # Create: AllConfigs.server().kinetics.windmillSailsPerRPM
MAX_RPM = 16           # Create: Mth.clamp(sails, 1, 16)
MIN_SAILS = 8          # below this a windmill will not run at all

# SU capacity generated. Create takes this from config rather than from the sail count;
# scaling it with the wheel's speed keeps a bigger windmill genuinely more useful.
CAPACITY_PER_RPM = 8.0

def _sail_count(contraption) {
    n = 0
    for block in contraption.blocks() {
        if contains(block.id, "sail") { n = n + 1 }
    }
    return n
}

def _stop() {
    Machine.set_rpm_output(0)
    Machine.report_su(0)
}

# The world axis the bearing turns about: the axis it FACES. A bearing on the ground faces up
# and turns flat (Y); one on a wall faces a horizontal direction and turns like a wheel (X or Z).
def _spin_axis() {
    if Machine.facing_dy != 0 { return "y" }
    if Machine.facing_dx != 0 { return "x" }
    return "z"
}

def status() {
    return rpm != 0 ? "true" : "false"
}

def on_break() {
    Machine.set_rpm_output(0)
    Machine.report_su(0)
}

# ---- tick ---------------------------------------------------------------

if Machine.get_flag("assembled") <= 0 {
    _stop()
    return
}

contraption = Machine.contraption

if contraption == null {
    # The contraption is gone (broken, unloaded past recovery): forget it and stop.
    Machine.set_flag("assembled", 0)
    Machine.set_str_flag("contraption_uuid", "")
    _stop()
    return
}

sails = _sail_count(contraption)

if sails < MIN_SAILS {
    # Create refuses to spin a windmill that does not have enough sail area.
    contraption.set_spin(_spin_axis(), 0)
    _stop()
    return
}

# Direction: +1 clockwise, -1 counter-clockwise. Create exposes this as a scroll option;
# here it is a flag the interact script toggles.
dir = Machine.get_flag("windmill_dir")
if dir == 0 { dir = 1 }

speed = clamp(floor(sails / SAILS_PER_RPM), 1, MAX_RPM)
rpm_out = speed * dir

# Drive the contraption's rotation directly. set_rpm only records a number on its state; this
# is what actually turns the body, about the bearing's own axis.
contraption.set_spin(_spin_axis(), rpm_out)
Machine.set_rpm_output(rpm_out)

su = speed * CAPACITY_PER_RPM
Machine.report_su(-su)   # negative = generates capacity for the network
