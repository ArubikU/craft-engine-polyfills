# Windmill Bearing — tick script, ported from Create's WindmillBearingBlockEntity.
#
#   int sails = sailBlocks / windmillSailsPerRPM;      // config default 8
#   return Mth.clamp(sails, 1, 16) * direction;        // 1..16 RPM
#
# Two things the previous version got wrong:
#
#  * `contraption.blocks()` was defined on the WRONG PolyType (ContraptionWorld, not Contraption —
#    two distinct registered types; Machine.contraption wraps as the latter), so the call always
#    resolved to no method at all and returned NULL. len(NULL) happens to answer 0, same as an
#    empty array, which is why this looked like "no sails" instead of an outright script error.
#    Fixed in ContraptionType.java by adding blocks()/get_block()/entities() to Contraption too.
#  * It used `sail_count * 8` unclamped. Create divides BY 8 and caps at 16, so eight sails give
#    1 rpm, not 64.

SAILS_PER_RPM = 8      # Create: AllConfigs.server().kinetics.windmillSailsPerRPM
MAX_RPM = 16           # Create: Mth.clamp(sails, 1, 16)
MIN_SAILS = 8          # below this a windmill will not run at all

# SU capacity generated. Create takes this from config rather than from the sail count;
# scaling it with the wheel's speed keeps a bigger windmill genuinely more useful.
CAPACITY_PER_RPM = 8.0

def _sail_count(contraption):
    n = 0
    for block in contraption.blocks():
        if contains(block.id, "sail"):
            n = n + 1
        end
    end
    return n
end

# Advances the SAME persisted angle the head-cap renderer reads (Machine.get_flag("head_angle"))
# by exactly the amount contraption.set_spin() just advanced the real contraption's rotation —
# same elapsed-real-ticks-since-last-call approach, same rpm value, same "1 RPM = 0.3 deg/tick"
# constant. This replaces an earlier attempt that had the RENDERER recompute an angle from
# "tick() - assembled_tick" (ticks since assembly) times the CURRENT rpm — correct only if rpm
# had been constant literally since assembly, which breaks after any speed/direction change,
# not just after a restart. Accumulating here, the same way the contraption itself does, stays
# correct through rpm changes AND survives a restart for free: elapsed = clamp(now-last, 0, 100)
# already floors to 0 when `now` resets below the old absolute `last` tick.
def _advance_head_angle(rpm_value):
    last = Machine.get_flag("head_last_tick")
    now = tick()
    if last <= 0:
        last = now
    end
    elapsed = clamp(now - last, 0, 100)
    Machine.set_flag("head_angle", Machine.get_flag("head_angle") + elapsed * rpm_value * 0.3)
    Machine.set_flag("head_last_tick", now)
end

def _stop():
    Machine.set_rpm_output(0)
    Machine.report_su(0)
    _advance_head_angle(0)
end

# The world axis the bearing turns about: the axis it FACES. A bearing on the ground faces up
# and turns flat (Y); one on a wall faces a horizontal direction and turns like a wheel (X or Z).
def _spin_axis():
    if Machine.facing_dy != 0:
        return "y"
    end
    if Machine.facing_dx != 0:
        return "x"
    end
    return "z"
end

def status():
    return rpm != 0 ? "true" : "false"
end

def on_break():
    Machine.set_rpm_output(0)
    Machine.report_su(0)
end

# ---- tick ---------------------------------------------------------------

if Machine.get_flag("assembled") <= 0:
    _stop()
    return
end

contraption = Machine.contraption

if contraption == null:
    # The contraption is gone (broken, unloaded past recovery): forget it and stop.
    Machine.set_flag("assembled", 0)
    Machine.set_str_flag("contraption_uuid", "")
    _stop()
    return
end

sails = _sail_count(contraption)

if sails < MIN_SAILS:
    # Create refuses to spin a windmill that does not have enough sail area.
    contraption.set_spin(_spin_axis(), 0)
    _stop()
    return
end

# Direction: +1 clockwise, -1 counter-clockwise. Create exposes this as a scroll option;
# here it is a flag the interact script toggles.
dir = Machine.get_flag("windmill_dir")
if dir == 0:
    dir = 1
end

speed = clamp(floor(sails / SAILS_PER_RPM), 1, MAX_RPM)
rpm_out = speed * dir

# Drive the contraption's rotation directly. set_rpm only records a number on its state; this
# is what actually turns the body, about the bearing's own axis.
contraption.set_spin(_spin_axis(), rpm_out)
Machine.set_rpm_output(rpm_out)
_advance_head_angle(rpm_out)

su = speed * CAPACITY_PER_RPM
Machine.report_su(-su)   # negative = generates capacity for the network



