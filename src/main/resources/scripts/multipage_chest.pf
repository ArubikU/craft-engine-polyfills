# Multipage Chest — button action functions for page navigation.
# Usage in buttons: action: "multipage_chest.pf:next_page"
#                   action: "multipage_chest.pf:prev_page"

def next_page():
    Machine.turn_page(1)
end

def prev_page():
    Machine.turn_page(-1)
end

def page_indicator():
    cur = Machine.get_flag("_current_page") + 1
    total = 3
    return "<gray>Page <white>" + cur + "<gray> / " + total
end



