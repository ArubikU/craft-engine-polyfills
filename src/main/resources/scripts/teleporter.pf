# Teleporter — global frequency network, entirely script-side (see the goal: "no dedicated
# TeleporterRegistry class, just the script engine (Server.*_flag / split / join / world()) and
# machines"). Java only supplies GENERIC primitives here — Machine.consume_energy,
# Server.get_str_flag/set_str_flag, split/join, world(name), World.location, Player.teleport_to —
# nothing that knows "teleporter" exists on the Java side at all.
#
# Registry shape: ONE Server string flag per frequency, "teleporter_freq_<name>", holding every
# teleporter tuned to it as "world,x,y,z" entries joined with ";" — e.g.
#   "minecraft:overworld,120,64,-30;minecraft:the_nether,15,80,4"
# A flat delimited string, not a richer structure, on purpose (see ServerFlags' own javadoc): that
# keeps the underlying primitive reusable for whatever the NEXT cross-block feature needs instead
# of it growing a bespoke shape for this one.

TELEPORT_COST = 5000

def get_frequency():
    return Machine.get_str_flag("frequency")
end

def freq_key(freq):
    return "teleporter_freq_" + freq
end

def my_pos_str():
    return World.name + "," + Machine.x + "," + Machine.y + "," + Machine.z
end

def register_self(freq):
    if freq == "":
        return
    end
    key = freq_key(freq)
    existing = Server.get_str_flag(key)
    mine = my_pos_str()
    for entry in split(existing, ";"):
        if entry == mine:
            return
        end
    end
    if existing == "":
        Server.set_str_flag(key, mine)
    else:
        Server.set_str_flag(key, existing + ";" + mine)
    end
end

def unregister_self(freq):
    if freq == "":
        return
    end
    key = freq_key(freq)
    existing = Server.get_str_flag(key)
    mine = my_pos_str()
    result = ""
    for entry in split(existing, ";"):
        if entry != "" && entry != mine:
            if result == "":
                result = entry
            else:
                result = result + ";" + entry
            end
        end
    end
    Server.set_str_flag(key, result)
end

def set_frequency(freq):
    old = get_frequency()
    if old == freq:
        return
    end
    unregister_self(old)
    Machine.set_str_flag("frequency", freq)
    register_self(freq)
end

def linked_count(freq):
    if freq == "":
        return 0
    end
    existing = Server.get_str_flag(freq_key(freq))
    mine = my_pos_str()
    n = 0
    for entry in split(existing, ";"):
        if entry != "" && entry != mine:
            n = n + 1
        end
    end
    return n
end

# --- GUI: frequency tuner (ghost slot — see MenuSlotType#GHOST). Insert a RENAMED item to tune
# the frequency to its display name; right-click clears it. Never holds a real item — see
# item_pipe_panel.pf's own writeup of why (the duplication exploit a real conjured-marker slot
# opened up) for the full reasoning; this reuses the exact same mechanism.
def ghost_get():
    return "cml:teleporter_core"
end

def ghost_set():
    if click_type == "right" || click_type == "shift_right":
        set_frequency("")
        Machine.update()
        return
    end
    if is_empty(clicked_item):
        return
    end
    set_frequency(clicked_item.name)
    # Force the status icon (frequency name/link count) to reflect the new tuning on THIS click,
    # instead of waiting up to 2 ticks for the normal periodic refresh.
    Machine.update()
end

# --- Info layout ---
def status_name():
    freq = get_frequency()
    if freq == "":
        return "<red>No frequency tuned"
    end
    return "<yellow>Frequency: <white>" + freq
end

def status_lore():
    freq = get_frequency()
    lines = []
    if freq == "":
        lines = push(lines, "<gray>Insert a renamed item below to tune one.")
        return lines
    end
    n = linked_count(freq)
    if n > 0:
        lines = push(lines, "<green>" + n + " other teleporter(s) linked.")
    else:
        lines = push(lines, "<red>No other teleporter tuned to this frequency yet.")
    end
    lines = push(lines, "<gray>Cost per jump: <white>" + TELEPORT_COST + " CE")
    return lines
end

# --- Teleport action ---
def do_teleport():
    freq = get_frequency()
    if freq == "":
        Player.send_message("<red>No frequency set — insert a renamed item to tune one first.")
        return
    end
    if Machine.energy_stored < TELEPORT_COST:
        Player.send_message("<red>Not enough energy — need " + TELEPORT_COST + " CE.")
        return
    end
    existing = Server.get_str_flag(freq_key(freq))
    mine = my_pos_str()
    for entry in split(existing, ";"):
        if entry != "" && entry != mine:
            parts = split(entry, ",")
            target_world = world(parts.get(0))
            if !is_empty(target_world):
                loc = target_world.location(int(parts.get(1)) + 0.5, int(parts.get(2)) + 1.5, int(parts.get(3)) + 0.5)
                if Machine.consume_energy(TELEPORT_COST):
                    Machine.close()
                    Player.teleport_to(loc)
                    Player.send_message("<green>Teleported via frequency '" + freq + "'.")
                end
                return
            end
        end
    end
    Player.send_message("<red>No other teleporter is currently reachable on '" + freq + "'.")
end

# --- Cleanup: detune when the block breaks, so a dead teleporter never blocks a working link with
# a stale, unreachable "world,x,y,z" entry that linked_count/do_teleport would otherwise still see.
def on_break():
    unregister_self(get_frequency())
end



