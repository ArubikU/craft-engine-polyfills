# Right-click cycles pulser duration: 5, 10, 20, 40, 60, 100 ticks
idx = Machine.get_flag("dur_idx")
next_idx = (idx + 1) % 6
Machine.set_flag("dur_idx", next_idx)

# Map index to duration value
dur = 5
if next_idx == 1:
    dur = 10
end
if next_idx == 2:
    dur = 20
end
if next_idx == 3:
    dur = 40
end
if next_idx == 4:
    dur = 60
end
if next_idx == 5:
    dur = 100
end
Machine.set_flag("duration", dur)
Machine.play_sound("minecraft:block.stone_button.click_on", 0.5, 1.0)



