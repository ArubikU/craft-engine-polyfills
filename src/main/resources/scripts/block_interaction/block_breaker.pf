# Block Breaker — breaks the block directly in front (facing direction).
# Progressive break animation, contraption-aware (breaks real-world block, not contraption internal).
# If inside a contraption, holds it still while breaking via ScriptStallBehavior.

UNBREAKABLE = make_map(
"minecraft:bedrock",    true,
"minecraft:end_portal", true,
"minecraft:barrier",    true
)

block = Machine.facing_block

if !block.is_air && !UNBREAKABLE.has(block.id):
    Machine.hold_contraption()

    # 10% per tick → 10 ticks to break (adjust for balance)
    drops = Machine.tick_break(block, 10)

    if drops != null:
        for drop in drops:
            Machine.container.push(drop)
        end
        Machine.release_contraption()
    end
else:
    # No target — clear any in-progress break and release hold
    Machine.release_contraption()
end



