# Block Placer — places a block from input slots into the facing direction.
# Uses facing_block for proper block inspection instead of scan_block_at (string-only).

facing = Machine.facing_block

if facing.is_air {
    placed = false
    for i in range(9) {
        if !placed {
            item = Machine.get_item_in_slot(i)
            if !is_empty(item) {
                ok = Machine.place_block_at(Machine.facing_dx, Machine.facing_dy, Machine.facing_dz, item)
                if ok {
                    Machine.remove_item_in_slot(i, 1)
                    placed = true
                }
            }
        }
    }
}
