# Drill — RPM-driven block breaker.
# Speed = abs(rpm) / 10 (supports both directions).
# Reports SU load proportional to block hardness to the RPM network.

if rpm == 0 {
    is_now = 0
} else {
    speed = max(1, abs(rpm) / 10)
    result = Machine.tick_break(Machine.facing_block, speed)
    Machine.add_items(result)
    # Report SU: harder blocks cost more. Base 8 SU + speed bonus.
    Machine.report_su(8 + speed)
    is_now = 1
}

was = Machine.get_flag("_drill_act")
if is_now != was {
    Machine.set_state("activated", is_now > 0 ? "true" : "false")
    Machine.set_flag("_drill_act", is_now)
}
