# Pulse Trigger — edge detector. Modes: 0=rising, 1=falling, 2=both.
mode = Machine.get_flag("edge_mode")
prev = Machine.get_flag("prev_power")
cur = Machine.redstone > 0 ? 1 : 0

fire = 0
if mode == 0 && cur == 1 && prev == 0:
    fire = 1
end
if mode == 1 && cur == 0 && prev == 1:
    fire = 1
end
if mode == 2 && cur != prev:
    fire = 1
end

if fire == 1:
    Machine.set_flag("pulse_t", 2)
end

t = Machine.get_flag("pulse_t")
if t > 0:
    Machine.emit_redstone(15)
    Machine.set_flag("pulse_t", t - 1)
else:
    Machine.emit_redstone(0)
end
Machine.set_flag("prev_power", cur)



