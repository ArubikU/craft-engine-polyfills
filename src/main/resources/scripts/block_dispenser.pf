# Block Dispenser — if facing space is empty: place block from inventory.
#                  If facing space is occupied: break it and collect drops.
# Uses facing_block + break_block for proper block state handling.

block = Machine.facing_block

if block.is_air {
    placed = false
    for i in range(27) {
        if !placed {
            item = Machine.get_item_in_slot(i)
            if !is_empty(item) {
                ok = Machine.place_block_at(Machine.facing_dx, Machine.facing_dy, Machine.facing_dz, item)
                if ok {
                    Machine.remove_item_in_slot(i, 1)
                    placed = true
                }
            }
        }
    }
} else {
    drops = Machine.break_block(block)
    for drop in drops {
        Machine.push_item_to_inventory(drop)
    }
}
