# Item Filter — slot 0 is the filter template item.
# Items above the block: if matching filter → push toward facing, else → push opposite.

filter = Machine.get_item_in_slot(0)
if is_empty(filter):
    return
end

filter_id = filter.id

for entity in Machine.nearby_entities(1.2):
    if entity.type == "minecraft:item":
        ey = entity.pos.y
        by = Machine.y
        if ey >= by && ey <= by + 1.5:
            if entity.item.id == filter_id:
                entity.push(vec(Machine.facing_dx * 0.3, 0.05, Machine.facing_dz * 0.3))
            else:
                entity.push(vec(Machine.facing_dx * -0.3, 0.05, Machine.facing_dz * -0.3))
            end
        end
    end
end



