# Wireless Redstone interact — right-click cycles mode (transmitter/receiver) or channel
# Sneak+click: switch mode (transmitter/receiver)
# Click: next channel (0-15)

if Player.is_sneaking:
    mode = Machine.get_flag("_wr_mode")
    new_mode = mode == 0 ? 1 : 0
    Machine.set_flag("_wr_mode", new_mode)
    if new_mode == 0:
        Player.send_message("<green>Wireless Redstone: TRANSMITTER")
    else:
        Player.send_message("<aqua>Wireless Redstone: RECEIVER")
    end
else:
    ch = Machine.get_flag("_wr_ch")
    new_ch = (ch + 1) % 16
    Machine.set_flag("_wr_ch", new_ch)
    Player.send_message("<yellow>Channel: " + new_ch)
end



