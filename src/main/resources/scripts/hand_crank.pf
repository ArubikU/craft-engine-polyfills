# Hand Crank — drains stored energy each tick, outputs RPM while energized.
energy = Machine.get_flag("crank_energy")
if energy > 0 {
    Machine.set_flag("crank_energy", energy - 1)
    Machine.set_rpm_output(16)
} else {
    Machine.set_rpm_output(0)
}
is_now = energy > 0 ? 1 : 0
was = Machine.get_flag("_hc_act")
if is_now != was {
    Machine.set_state("activated", is_now > 0 ? "true" : "false")
    Machine.set_flag("_hc_act", is_now)
}
