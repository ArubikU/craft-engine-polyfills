# Specialized Teleporter - same frequency network as the classic teleporter.pf (identical
# "teleporter_freq_<name>" Server string-flag registry, so the two interoperate: tune both to the
# same frequency and either one can reach the other) but instead of blindly warping to the FIRST
# other teleporter found, it lists every reachable destination as its own button and lets the
# player pick one. There is no cross-file function-call syntax for .pf scripts (only string refs
# resolved by Java), so the small registry helpers below are a deliberate copy of teleporter.pf's,
# not a shared import.
#
# The whole button layout - prev/next nav AND every destination slot - comes from ONE generator,
# "buttons": "specialized_teleporter.pf:generate_buttons" in specialized_teleporter.json, instead
# of a static per-slot array. Java calls this fresh EVERY render tick (not just once when the menu
# opens - see DataMachineBlockEntity#installGeneratedButton) and on every click, so tuning a new
# frequency, another teleporter registering/unregistering, or paging all show up live without
# closing and reopening the menu. A destination slot simply isn't in the returned list when there's
# nothing to show there - no separate "hide this button" mechanism needed.

TELEPORT_COST = 10000
DEST_PAGE_SIZE = 28
DEST_SLOTS = [10,11,12,13,14,15,16, 19,20,21,22,23,24,25, 28,29,30,31,32,33,34, 37,38,39,40,41,42,43]

def get_frequency():
    return Machine.get_typed("frequency", "string")
end

def freq_key(freq):
    return "teleporter_freq_" + freq
end

def my_pos_str():
    return World.name + "," + Machine.x + "," + Machine.y + "," + Machine.z
end

def register_self(freq):
    if freq == "":
        return
    end
    key = freq_key(freq)
    existing = Server.get_typed(key, "string")
    mine = my_pos_str()
    for entry in split(existing, ";"):
        if entry == mine:
            return
        end
    end
    if existing == "":
        Server.set_typed(key, "string", mine)
    else:
        Server.set_typed(key, "string", existing + ";" + mine)
    end
end

def unregister_self(freq):
    if freq == "":
        return
    end
    key = freq_key(freq)
    existing = Server.get_typed(key, "string")
    mine = my_pos_str()
    result = ""
    for entry in split(existing, ";"):
        if entry != "" && entry != mine:
            if result == "":
                result = entry
            else:
                result = result + ";" + entry
            end
        end
    end
    Server.set_typed(key, "string", result)
end

def set_frequency(freq):
    old = get_frequency()
    if old == freq:
        return
    end
    unregister_self(old)
    Machine.set_typed("frequency", "string", freq)
    register_self(freq)
    Machine.set_typed("page_offset", "int", 0)
end

# Reads the first non-empty line off a sign mounted on any of the 6 faces adjacent to
# (world_name, x, y, z), or "" if none is found - lets a destination (or this teleporter itself)
# show a friendly alias instead of raw coordinates when someone bothers to label it. Same helper
# as teleporter.pf's - duplicated, not shared, per this file's own header note on why.
#
# get_block(...,true) force-loads the chunk first: plain NMS block reads on an unloaded chunk
# silently return air (no sign ever detected) instead of loading anything, which is exactly why a
# destination teleporter far from any online player never showed its alias in the GUI even after
# reopening it, while a nearby redstone-triggered pair (whose chunk was already loaded from normal
# play) worked fine - the block was never actually air, it just was never being read correctly.
def _sign_alias_at(world_name, x, y, z):
    tw = world(world_name)
    if is_empty(tw):
        return ""
    end
    center = tw.get_block(int(x), int(y), int(z), true)
    for dir in ["north", "south", "east", "west", "up", "down"]:
        b = center.relative(dir)
        if b.metadata_type == "SignMetadata":
            for line in b.get_metadata.front.lines:
                if line != "":
                    return line
                end
            end
            return ""
        end
    end
    return ""
end

# This teleporter's own alias - the first non-empty front line of a sign mounted on one of its
# own faces, or "" if it isn't labeled.
def _own_alias():
    return _sign_alias_at(World.name, Machine.x, Machine.y, Machine.z)
end

# Every OTHER teleporter tuned to freq, as "world,x,y,z" strings, in stable registration order -
# the same list generate_buttons()/do_teleport_slot index into.
def frequency_entries(freq):
    entries = []
    if freq == "":
        return entries
    end
    existing = Server.get_typed(freq_key(freq), "string")
    mine = my_pos_str()
    for entry in split(existing, ";"):
        if entry != "" && entry != mine:
            entries = push(entries, entry)
        end
    end
    return entries
end

def total_pages(freq):
    n = len(frequency_entries(freq))
    if n <= 0:
        return 1
    end
    return int(floor((n - 1) / DEST_PAGE_SIZE)) + 1
end

# --- GUI: frequency tuner (ghost slot) - identical convention to teleporter.pf.
def ghost_get():
    return "cml:teleporter_core"
end

def ghost_set():
    if click_type == "right" || click_type == "shift_right":
        set_frequency("")
        Machine.update()
        return
    end
    if is_empty(clicked_item):
        return
    end
    set_frequency(clicked_item.name)
    # Force the status icon (frequency name/destination count) and the destination buttons to
    # reflect the new tuning on THIS click, instead of waiting up to 2 ticks for the normal
    # periodic refresh.
    Machine.update()
end

# --- Info layout ---
def status_name():
    freq = get_frequency()
    if freq == "":
        return "<red>No frequency tuned"
    end
    alias = _own_alias()
    if alias != "":
        return "<yellow>Frequency: <white>" + freq + " <gray>(" + alias + ")"
    end
    return "<yellow>Frequency: <white>" + freq
end

def status_lore():
    freq = get_frequency()
    lines = []
    if freq == "":
        lines = push(lines, "<gray>Insert a renamed item below to tune one.")
        return lines
    end
    n = len(frequency_entries(freq))
    if n > 0:
        lines = push(lines, "<green>" + n + " destination(s) available.")
    else:
        lines = push(lines, "<red>No other teleporter tuned to this frequency yet.")
    end
    lines = push(lines, "<gray>Page <white>" + (Machine.get_typed("page_offset", "int") + 1) + "<gray>/<white>" + total_pages(freq))
    lines = push(lines, "<gray>Cost per jump: <white>" + TELEPORT_COST + " CE")
    return lines
end

# --- Generated button layout: prev/next nav (only when actually usable) plus one button per
# reachable destination on the current page. Called fresh every render tick AND on every click -
# see specialized_teleporter.json's "buttons" field and DataMachineBlockEntity#installGeneratedButton.
def generate_buttons():
    out = []
    freq = get_frequency()
    entries = frequency_entries(freq)
    offset = Machine.get_typed("page_offset", "int")
    tp = total_pages(freq)

    if offset > 0:
        out = push(out, make_map("slot", 45, "icon", "cml:prev_icon",
            "name", "<yellow><- Previous Page", "action", "specialized_teleporter.pf:prev_page"))
    end
    if offset + 1 < tp:
        out = push(out, make_map("slot", 53, "icon", "internal:next_page_0",
            "name", "<yellow>Next Page ->", "action", "specialized_teleporter.pf:next_page"))
    end

    # Second way to tune the frequency, alongside the ghost-slot item (slot 0): a dialog with a
    # single text field, pre-filled with the current frequency. Doesn't replace the item-based
    # tuning - some players find typing a name faster than finding/renaming an item, others the
    # other way around, so both stay available.
    out = push(out, make_map("slot", 5, "icon", "cml:teleporter_core",
        "name", "<aqua>Tune via Dialog",
        "lore", ["<gray>Type a frequency instead of", "<gray>inserting a renamed item."],
        "action", "specialized_teleporter.pf:open_frequency_dialog"))

    start = offset * DEST_PAGE_SIZE
    for i in range(DEST_PAGE_SIZE):
        global_idx = start + i
        if global_idx >= len(entries):
            break
        end
        entry = entries.get(global_idx)
        parts = split(entry, ",")
        alias = _sign_alias_at(parts.get(0), parts.get(1), parts.get(2), parts.get(3))
        display_name = alias != "" ? alias : parts.get(0)
        lore = []
        lore = push(lore, "<gray>" + parts.get(1) + ", " + parts.get(2) + ", " + parts.get(3))
        lore = push(lore, "<dark_gray>Click to teleport <white>(" + TELEPORT_COST + " CE)")
        out = push(out, make_map(
            "slot", DEST_SLOTS.get(i),
            "icon", "cml:teleporter_core",
            "name", "<yellow>" + display_name,
            "lore", lore,
            "action", "specialized_teleporter.pf:do_teleport_slot:" + i
        ))
    end
    return out
end

def do_teleport_slot(idx):
    freq = get_frequency()
    if freq == "":
        return
    end
    entries = frequency_entries(freq)
    global_idx = Machine.get_typed("page_offset", "int") * DEST_PAGE_SIZE + int(idx)
    if global_idx < 0 || global_idx >= len(entries):
        return
    end
    if Machine.energy_stored < TELEPORT_COST:
        Player.send_message("<red>Not enough energy - need " + TELEPORT_COST + " CE.")
        return
    end
    entry = entries.get(global_idx)
    parts = split(entry, ",")
    target_world = world(parts.get(0))
    if is_empty(target_world):
        Player.send_message("<red>That destination's world is not currently loaded.")
        return
    end
    loc = target_world.location(int(parts.get(1)) + 0.5, int(parts.get(2)) + 1.5, int(parts.get(3)) + 0.5)
    if Machine.consume_energy(TELEPORT_COST):
        Machine.close()
        Player.teleport_to(loc)
        Player.send_message("<green>Teleported to " + parts.get(0) + ".")
    end
end

# --- Dialog-based frequency tuning (see generate_buttons' "Tune via Dialog" button). The dialog's
# Accept button calls on_frequency_dialog_submit with whatever the player typed appended as its
# argument - same convention any other action_ref callback uses, just supplied at click time
# instead of baked into the ref string (see DialogManagerType / ScriptCall#executeWithExtraArgs).
# Dialog is its own type (not hung off Machine), so Machine/Player are passed in explicitly.
def open_frequency_dialog():
    Dialog.base("Tune Frequency").input_text("value", "Frequency", get_frequency()).as_notice(Machine, "Accept", "specialized_teleporter.pf:on_frequency_dialog_submit").show(Player)
end

def on_frequency_dialog_submit(new_freq):
    set_frequency(new_freq)
    Machine.update()
end

# --- In-page pagination ---
def next_page():
    freq = get_frequency()
    tp = total_pages(freq)
    cur = Machine.get_typed("page_offset", "int")
    if cur + 1 < tp:
        Machine.set_typed("page_offset", "int", cur + 1)
    end
end

def prev_page():
    cur = Machine.get_typed("page_offset", "int")
    if cur > 0:
        Machine.set_typed("page_offset", "int", cur - 1)
    end
end

# --- Redstone-triggered teleport-by-alias: wire a button/lever/pressure plate to this teleporter
# (see specialized_teleporter.json's "on_redstone_actuator"). If THIS teleporter is labeled with a
# sign, triggering it teleports the pressing player straight to whichever OTHER teleporter on the
# same frequency is labeled with the SAME sign text - skipping the destination-picker GUI
# entirely. RedstoneActuatorListener only calls this on an actual physical trigger (pressure plate
# step, lever flip, button press), not every tick a lever/plate stays powered, so no rising-edge
# tracking is needed here - and it hands us the real triggering Player, same as on_interact.
def on_redstone_actuator():
    alias = _own_alias()
    if alias == "":
        return
    end
    freq = get_frequency()
    if freq == "":
        return
    end
    for entry in frequency_entries(freq):
        parts = split(entry, ",")
        if _sign_alias_at(parts.get(0), parts.get(1), parts.get(2), parts.get(3)) == alias:
            if Machine.energy_stored < TELEPORT_COST:
                Player.send_message("<red>Not enough energy - need " + TELEPORT_COST + " CE.")
                return
            end
            target_world = world(parts.get(0))
            if is_empty(target_world):
                Player.send_message("<red>That destination's world is not currently loaded.")
                return
            end
            loc = target_world.location(int(parts.get(1)) + 0.5, int(parts.get(2)) + 1.5, int(parts.get(3)) + 0.5)
            if Machine.consume_energy(TELEPORT_COST):
                Player.teleport_to(loc)
                Player.send_message("<green>Teleported to <white>" + alias + "<green>.")
            end
            return
        end
    end
    Player.send_message("<red>No other teleporter labeled '" + alias + "' found on this frequency.")
end

# --- Right-click open: forces Machine.open_menu to build a FRESH layout (see its Java-side
# comment) instead of letting MachineBlockBehavior's default path reopen whatever MachineMenu is
# already cached - otherwise generate_buttons() (and the destination aliases it bakes in) would
# only ever refresh on Machine.update() (e.g. re-tuning the frequency), not on a plain reopen.
def on_right_click():
    Machine.open_menu(Player)
end

# --- Cleanup: detune when the block breaks, same reasoning as teleporter.pf's on_break.
def on_break():
    unregister_self(get_frequency())
end
