# ---- Favourite page (favourite.yml -> cml:player_warps_submenu_1) ---------------------------

def favourite_title():
    return "{Images.from('cml:player_warps_submenu_1')}{Images.shift(-170)}<black> Favourite Warps"
end

def favourite_rows():
    like = "%" + lower(Player.get_typed("warps_search", "string")) + "%"
    return SQL.query("SELECT w.* FROM warp_favourites f JOIN warps w ON w.id = f.warp_id " +
        "WHERE f.player_uuid = ? AND (lower(w.name) LIKE ? OR lower(w.owner_name) LIKE ?) ORDER BY w.name ASC",
        Player.uuid, like, like)
end

def generate_favourite_buttons():
    out = []
    rows = favourite_rows()
    ban_ids = player_banned_ids()
    offset = Player.get_typed("warps_favourite_offset", "int")
    start = offset * WARP_PAGE_SIZE_LIST
    for i in range(0, WARP_PAGE_SIZE_LIST):
        global_idx = start + i
        if global_idx >= len(rows):
            break
        end
        row = rows.get(global_idx)
        name = row.get("name")
        # Every row here is already a favourite by construction (the JOIN itself is the
        # membership check) — no need for a THIRD query to re-confirm what got it here.
        out = push(out, make_map("slot", WARP_SLOTS_LIST.get(i), "icon", warp_icon_of(row),
            "name", "<yellow>" + name,
            "lore", warp_lore_of(row, true, arr_contains(ban_ids, row.get("id"))),
            "action", "warps.pf:on_favourite_click:" + name))
    end
    return out
end

