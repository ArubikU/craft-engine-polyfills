    Cmd.open_page("banned")
end

def mw_open_rename_dialog():
    Dialog.base("Rename Warp").input_text("value", "New Name", current_warp()).as_notice(Cmd, "Rename", "warps.pf:on_rename_submit").show(Player)
end

# The whole point of keying every OTHER table by warp_id (a stable UUID) instead of the display
# name: renaming is now JUST this one UPDATE. Every ban/favourite/visitor/rating row is still
# attached — none of them ever referenced the name.
def on_rename_submit(value):
    old_name = current_warp()
    new_name = sanitize(value)
    if !is_owner(old_name) || new_name == "" || warp_exists(new_name):
        Player.send_message("<red>✘ <white>Could not rename that warp.")
        return
    end
    SQL.execute("UPDATE warps SET name = ? WHERE id = ?", new_name, warp_id(old_name))
    Player.set_typed("warps_current_warp", "string", new_name)
    Player.send_message("<green>✔ <white>Renamed to '" + new_name + "'.")
end

def mw_delete():
    name = current_warp()
    if delete_warp(name):
        Player.send_message("<green>✔ <white>Deleted warp '" + name + "'.")
        Cmd.open_page("manage")
    else:
        Player.send_message("<red>✘ <white>You don't own that warp.")
    end
end

def mw_open_transfer_dialog():
    Dialog.base("Transfer Ownership").input_text("value", "New Owner Name", "").as_notice(Cmd, "Transfer", "warps.pf:on_transfer_submit").show(Player)
end

def on_transfer_submit(value):
    name = current_warp()
    if !is_owner(name):
        return
    end
    target_name = sanitize(value)
    target = Server.get_player(target_name)
    if is_empty(target):
        Player.send_message("<red>✘ <white>" + target_name + " is not online.")
        return
    end
    SQL.execute("UPDATE warps SET owner_uuid = ?, owner_name = ? WHERE id = ?", target.uuid, target.name, warp_id(name))
    Player.send_message("<green>✔ <white>Transferred " + name + " to " + target.name + ".")
    Cmd.open_page("manage")
end

# ---- bannedplayers.yml -> cml:player_warps_banned_players ------------------------------------

def banned_title():
    return "{Images.from('cml:player_warps_banned_players')}{Images.shift(-170)}<black> Banned Players > " + current_warp()
end

# A REAL indexed query now (see __init__'s warp_bans table) instead of loading every ban and
# filtering it in-script — the exact "search/filter" case the SQL motor exists for.
def banned_records():
    search = lower(Player.get_typed("warps_banned_search", "string"))
    wid = warp_id(current_warp())
    if search == "":
        rows = SQL.query("SELECT uuid, name FROM warp_bans WHERE warp_id = ? ORDER BY name", wid)
    else:
        rows = SQL.query("SELECT uuid, name FROM warp_bans WHERE warp_id = ? AND lower(name) LIKE ? ORDER BY name",
            wid, "%" + search + "%")
    end
    out = []
    for row in rows:
        out = push(out, make_map("uuid", row.get("uuid"), "name", row.get("name")))
    end
    return out
end

# Same "reopen the right page" convention as the warps/manage/favourite Search button — see
# open_search_dialog/on_search_submit above — mirrored here for the banned/visited player lists
# (ported from bannedplayers.yml/visitedplayers.yml's own "search" section, slot 25).
def open_banned_search_dialog():
    Dialog.base("Search Banned Players").input_text("value", "Player name", Player.get_typed("warps_banned_search", "string")).as_notice(Cmd, "Search", "warps.pf:on_banned_search_submit").show(Player)
end

def on_banned_search_submit(value):
    Player.set_typed("warps_banned_search", "string", sanitize(value))
    Player.set_typed("warps_banned_offset", "int", 0)
    Cmd.open_page("banned")
end

def generate_banned_buttons():
    out = []
    records = banned_records()
    offset = Player.get_typed("warps_banned_offset", "int")
    start = offset * WARP_PAGE_SIZE_LIST
    for i in range(0, WARP_PAGE_SIZE_LIST):
        global_idx = start + i
        if global_idx >= len(records):
            break
        end
        entry = records.get(global_idx)
        target_uuid = entry.get("uuid")
        target_name = entry.get("name")
        out = push(out, make_map("slot", WARP_SLOTS_LIST.get(i), "icon", player_head_icon(target_name),
            "name", "<white>" + target_name,
            "lore", ["<gray>Banned from <white>" + current_warp(), "", "<red>Left-click to unban"],
            "action", "warps.pf:on_unban_click:" + target_uuid))
    end
    return out
end

def on_unban_click(target_uuid):
    name = current_warp()
    if !is_owner(name):
        return
    end
    SQL.execute("DELETE FROM warp_bans WHERE warp_id = ? AND uuid = ?", warp_id(name), target_uuid)
    Player.send_message("<green>✔ <white>Unbanned.")
    Cmd.open_page("banned")
end

def max_banned_offset():
    n = len(banned_records())
    if n <= 0:
        return 0
    end
    return int(floor((n - 1) / WARP_PAGE_SIZE_LIST))
end

def prev_banned_page():
    offset = Player.get_typed("warps_banned_offset", "int")
    if offset > 0:
        Player.set_typed("warps_banned_offset", "int", offset - 1)
    end
    Cmd.open_page("banned")
end

def next_banned_page():
    offset = Player.get_typed("warps_banned_offset", "int")
    if offset < max_banned_offset():
        Player.set_typed("warps_banned_offset", "int", offset + 1)
    end
    Cmd.open_page("banned")
end

# ---- visitedplayers.yml -> cml:player_warps_visited_players -----------------------------------

def visited_title():
    return "{Images.from('cml:player_warps_visited_players')}{Images.shift(-170)}<black> Visited Players > " + current_warp()
end

def visitor_records():
    search = lower(Player.get_typed("warps_visited_search", "string"))
    wid = warp_id(current_warp())
    if search == "":
        rows = SQL.query("SELECT uuid, name, count FROM warp_visitors WHERE warp_id = ? ORDER BY name", wid)
    else:
        rows = SQL.query("SELECT uuid, name, count FROM warp_visitors WHERE warp_id = ? AND lower(name) LIKE ? ORDER BY name",
            wid, "%" + search + "%")
    end
    out = []
    for row in rows:
        out = push(out, make_map("uuid", row.get("uuid"), "name", row.get("name"), "count", row.get("count")))
    end
    return out
end

def open_visited_search_dialog():
    Dialog.base("Search Visited Players").input_text("value", "Player name", Player.get_typed("warps_visited_search", "string")).as_notice(Cmd, "Search", "warps.pf:on_visited_search_submit").show(Player)
end

def on_visited_search_submit(value):
    Player.set_typed("warps_visited_search", "string", sanitize(value))
    Player.set_typed("warps_visited_offset", "int", 0)
    Cmd.open_page("visited")
end

def generate_visited_buttons():
    out = []
    records = visitor_records()
    offset = Player.get_typed("warps_visited_offset", "int")
    start = offset * WARP_PAGE_SIZE_LIST
    for i in range(0, WARP_PAGE_SIZE_LIST):
        global_idx = start + i
        if global_idx >= len(records):
            break
        end
        entry = records.get(global_idx)
        visitor_name = entry.get("name")
        out = push(out, make_map("slot", WARP_SLOTS_LIST.get(i), "icon", player_head_icon(visitor_name),
            "name", "<white>" + visitor_name,
            "lore", ["<gray>Visited <white>" + int(entry.get("count")) + " <gray>time(s)"]))
    end
    return out
end

def max_visited_offset():
    n = len(visitor_records())
    if n <= 0:
        return 0
    end
    return int(floor((n - 1) / WARP_PAGE_SIZE_LIST))
end

def prev_visited_page():
    offset = Player.get_typed("warps_visited_offset", "int")
    if offset > 0:
        Player.set_typed("warps_visited_offset", "int", offset - 1)
    end
    Cmd.open_page("visited")
end

def next_visited_page():
    offset = Player.get_typed("warps_visited_offset", "int")
    if offset < max_visited_offset():
        Player.set_typed("warps_visited_offset", "int", offset + 1)
    end
    Cmd.open_page("visited")
end

# ---- visitedit.yml -> cml:player_warps_manage_visit: quick Rate/Teleport/Favourite panel -----

def visitedit_title():
    return "{Images.from('cml:player_warps_manage_visit')}{Images.shift(-170)}<black> Manage Visit > " + current_warp()
end

# visitedit is reached by right-clicking a warp row from THREE different list pages (browse/
# manage/favourite — see their on_*_click handlers, which each stamp "warps_return_page" right
# before opening this page) — a static "page:X" back button can only ever be right for one of
# them, which is exactly why it kept pointing at the wrong list. Falls back to "warps" if the flag
# was somehow never set (e.g. this page reached some other way in the future).
def on_visitedit_back():
    target = Player.get_typed("warps_return_page", "string")
    if target == "":
        target = "warps"
    end
    Cmd.open_page(target)
end

def vi_teleport():
    teleport_to_warp(current_warp())
end

def vi_toggle_favourite():
    toggle_favourite(current_warp())
end

def vi_open_rate_dialog():
    Dialog.base("Rate Warp").input_number("stars", "Stars (0-5)", 0, 5, 1, 5).as_notice(Cmd, "Rate", "warps.pf:on_rate_submit").show(Player)
end

def on_rate_submit(stars):
    name = current_warp()
    if is_owner(name):
        Player.send_message("<red>✘ <white>You can't rate your own warp.")
        return
    end
    n = int(stars)
    if n < 0:
        n = 0
    end
    if n > 5:
        n = 5
    end
    wid = warp_id(name)
    SQL.execute("DELETE FROM warp_ratings WHERE warp_id = ? AND uuid = ?", wid, Player.uuid)
    SQL.execute("INSERT INTO warp_ratings (warp_id, uuid, name, stars) VALUES (?, ?, ?, ?)", wid, Player.uuid, Player.name, n)
    Player.send_message("<green>✔ <white>Rated " + name + " " + n + " star(s).")
end

# ---- rate.yml -> cml:player_warps_submenu_2: this warp's rating list --------------------------

def rate_title():
    return "{Images.from('cml:player_warps_submenu_2')}{Images.shift(-170)}<black> Warp Rates > " + current_warp()
end

def rating_records():
    rows = SQL.query("SELECT uuid, name, stars FROM warp_ratings WHERE warp_id = ? ORDER BY name", warp_id(current_warp()))
    out = []
    for row in rows:
        out = push(out, make_map("uuid", row.get("uuid"), "name", row.get("name"), "stars", row.get("stars")))
    end
    return out
end

def generate_rate_buttons():
    out = []
    records = rating_records()
    offset = Player.get_typed("warps_rate_offset", "int")
    start = offset * WARP_PAGE_SIZE_LIST
    for i in range(0, WARP_PAGE_SIZE_LIST):
        global_idx = start + i
        if global_idx >= len(records):
            break
        end
        entry = records.get(global_idx)
        rater_uuid = entry.get("uuid")
        rater_name = entry.get("name")
        stars = entry.get("stars")
        lore = ["<gray>Rating: <yellow>" + stars + "/5"]
        if rater_uuid == Player.uuid:
            lore = push(lore, "")
            lore = push(lore, "<red>Left-click to remove your rating")
        end
        out = push(out, make_map("slot", WARP_SLOTS_LIST.get(i), "icon", player_head_icon(rater_name),
            "name", "<white>" + rater_name + "'s rate", "lore", lore,
            "action", "warps.pf:on_unrate_click:" + rater_uuid))
    end
    return out
end

def on_unrate_click(rater_uuid):
    if rater_uuid != Player.uuid:
        return
    end
    SQL.execute("DELETE FROM warp_ratings WHERE warp_id = ? AND uuid = ?", warp_id(current_warp()), rater_uuid)
    Cmd.open_page("rate")
end

def max_rate_offset():
    n = len(rating_records())
    if n <= 0:
        return 0
    end
    return int(floor((n - 1) / WARP_PAGE_SIZE_LIST))
end

def prev_rate_page():
    offset = Player.get_typed("warps_rate_offset", "int")
    if offset > 0:
        Player.set_typed("warps_rate_offset", "int", offset - 1)
    end
    Cmd.open_page("rate")
end

def next_rate_page():
    offset = Player.get_typed("warps_rate_offset", "int")
    if offset < max_rate_offset():
        Player.set_typed("warps_rate_offset", "int", offset + 1)
    end
    Cmd.open_page("rate")
end

# ---- Chat command surface (config.yml's "sub-commands" list) — the command-line equivalent of
# the GUI actions above, for players who prefer typing over clicking (or for a use case the GUI
# doesn't cover at all, like managing a warp you don't own via PERM_ADMIN_BYPASS). Every one of
# these reuses the SAME underlying SQL the GUI handlers use — no separate logic path to drift out
# of sync. See the PERM_ADMIN_BYPASS/can_manage note above for why ordinary commands don't check a
# permission node beyond ownership, and cmds/warps.json for the three that DO (removeall/reload/
# addwarps — hidden entirely from a player without the node via Brigadier's own "permission" field,
# not just refused after the fact).
#
# NOT ported (documented, not silently dropped — none of the underlying systems exist in this
# engine and building them now would be its own separate project): password protection, whitelist,
# managers (co-owners), warp renting, sign-based warping, /pw near, /pw rtp, per-warp teleport
# COST overrides (this addon only has the one global WARP_TELEPORT_COST), and PAPI placeholders in
# descriptions/ratings. "/pw list/amount [player]" became separate "list"/"listof" and "amount"/
# "amountof" commands instead of one command with an optional trailing player arg — this command
# engine's arg chains don't support an optional value arg cleanly.

def cmd_help():
    Player.send_message("<yellow>--- /warps commands ---")
    Player.send_message("<white>/warps <gray>- open the warps menu")
    Player.send_message("<white>/warps create|set <name> <gray>- create a warp (set also repositions your own)")
    Player.send_message("<white>/warps remove <warp> <gray>- delete a warp you own")
    Player.send_message("<white>/warps desc set <warp> <text> <gray>|<white> desc remove <warp>")
    Player.send_message("<white>/warps list <gray>|<white> listof <player>")
    Player.send_message("<white>/warps amount <gray>|<white> amountof <player>")
    Player.send_message("<white>/warps icon set <warp> <gray>(uses held item) <white>|<gray> icon remove <warp>")
    Player.send_message("<white>/warps category set <warp> <category> <gray>|<white> category remove <warp>")
    Player.send_message("<white>/warps rate <warp> <0-5>")
    Player.send_message("<white>/warps lock <warp> <gray>- toggle public/hidden")
    Player.send_message("<white>/warps reset <warp> <gray>- move it to your location")
    Player.send_message("<white>/warps rename <warp> <new name>")
    Player.send_message("<white>/warps setowner <warp> <player>")
    Player.send_message("<white>/warps ban set <warp> <player> <gray>|<white> ban remove <warp> <player>")
    Player.send_message("<white>/warps favourite <warp> <gray>- toggle favourite")
    Player.send_message("<white>/warps buyslot <gray>- spend XP for an extra warp slot")
end

def cmd_remove():
    name = Cmd.arg("name")
    if !warp_exists(name):
        Player.send_message("<red>✘ <white>No warp named '" + name + "'.")
        return
    end
    if !can_manage(name):
        Player.send_message("<red>✘ <white>You don't own that warp.")
        return
    end
    SQL.execute("DELETE FROM warps WHERE id = ?", warp_id(name))
    Player.send_message("<green>✔ <white>Deleted warp '" + name + "'.")
end

def cmd_desc_set():
    name = Cmd.arg("name")
    if !warp_exists(name):
        Player.send_message("<red>✘ <white>No warp named '" + name + "'.")
        return
    end
    if !can_manage(name):
        Player.send_message("<red>✘ <white>You don't own that warp.")
        return
    end
    SQL.execute("UPDATE warps SET desc = ? WHERE id = ?", sanitize(Cmd.arg("text")), warp_id(name))
    Player.send_message("<green>✔ <white>Description updated.")
end

def cmd_desc_remove():
    name = Cmd.arg("name")
    if !warp_exists(name):
        Player.send_message("<red>✘ <white>No warp named '" + name + "'.")
        return
    end
    if !can_manage(name):
        Player.send_message("<red>✘ <white>You don't own that warp.")
        return
    end
    SQL.execute("UPDATE warps SET desc = '' WHERE id = ?", warp_id(name))
    Player.send_message("<green>✔ <white>Description cleared.")
end

def warp_names_summary(owner_uuid):
    rows = SQL.query("SELECT name FROM warps WHERE owner_uuid = ? ORDER BY created_at ASC", owner_uuid)
    names = ""
    for row in rows:
        if names == "":
            names = row.get("name")
        else:
            names = names + "<gray>, <white>" + row.get("name")
        end
    end
    return make_map("count", len(rows), "names", names)
end

def cmd_list():
    info = warp_names_summary(Player.uuid)
    if int(info.get("count")) <= 0:
        Player.send_message("<yellow>You have no warps.")
        return
    end
    Player.send_message("<yellow>Your warps (" + info.get("count") + "): <white>" + info.get("names"))
end

def cmd_listof():
    target = Cmd.arg("player")
    info = warp_names_summary(target.uuid)
    if int(info.get("count")) <= 0:
        Player.send_message("<yellow>" + target.name + " has no warps.")
        return
    end
    Player.send_message("<yellow>" + target.name + "'s warps (" + info.get("count") + "): <white>" + info.get("names"))
end

def cmd_amount():
    Player.send_message("<yellow>You have <white>" + len(owned_warp_names()) + "/" + effective_limit() + "<yellow> warps.")
end

def cmd_amountof():
    target = Cmd.arg("player")
    n = len(SQL.query("SELECT id FROM warps WHERE owner_uuid = ?", target.uuid))
    Player.send_message("<yellow>" + target.name + " has <white>" + n + "<yellow> warp(s).")
end

def cmd_icon_set():
    name = Cmd.arg("name")
    if !warp_exists(name):
        Player.send_message("<red>✘ <white>No warp named '" + name + "'.")
        return
    end
    if !can_manage(name):
        Player.send_message("<red>✘ <white>You don't own that warp.")
        return
    end
    held = Player.main_hand
    if is_empty(held):
        Player.send_message("<red>✘ <white>Hold an item first.")
        return
    end
    SQL.execute("UPDATE warps SET icon = ? WHERE id = ?", held.id, warp_id(name))
    Player.send_message("<green>✔ <white>Icon updated.")
end

def cmd_icon_remove():
    name = Cmd.arg("name")
    if !warp_exists(name):
        Player.send_message("<red>✘ <white>No warp named '" + name + "'.")
        return
    end
    if !can_manage(name):
        Player.send_message("<red>✘ <white>You don't own that warp.")
        return
    end
    SQL.execute("UPDATE warps SET icon = '' WHERE id = ?", warp_id(name))
    Player.send_message("<green>✔ <white>Icon reset to default.")
end

def cmd_category_set():
    name = Cmd.arg("name")
    if !warp_exists(name):
        Player.send_message("<red>✘ <white>No warp named '" + name + "'.")
        return
    end
    if !can_manage(name):
        Player.send_message("<red>✘ <white>You don't own that warp.")
        return
    end
    cat = sanitize(Cmd.arg("category"))
    if cat == "":
        cat = "other"
    end
    SQL.execute("UPDATE warps SET category = ? WHERE id = ?", lower(cat), warp_id(name))
    Player.send_message("<green>✔ <white>Category set to '" + cat + "'.")
end

def cmd_category_remove():
    name = Cmd.arg("name")
    if !warp_exists(name):
        Player.send_message("<red>✘ <white>No warp named '" + name + "'.")
        return
    end
    if !can_manage(name):
        Player.send_message("<red>✘ <white>You don't own that warp.")
        return
    end
    SQL.execute("UPDATE warps SET category = 'other' WHERE id = ?", warp_id(name))
    Player.send_message("<yellow>Category reset to 'other'.")
end

def cmd_rate():
    name = Cmd.arg("name")
    if !warp_exists(name):
        Player.send_message("<red>✘ <white>No warp named '" + name + "'.")
        return
    end
    if is_owner(name):
        Player.send_message("<red>✘ <white>You can't rate your own warp.")
        return
    end
    n = int(Cmd.arg("stars"))
    if n < 0:
        n = 0
    end
    if n > 5:
        n = 5
    end
    wid = warp_id(name)
    SQL.execute("DELETE FROM warp_ratings WHERE warp_id = ? AND uuid = ?", wid, Player.uuid)
    SQL.execute("INSERT INTO warp_ratings (warp_id, uuid, name, stars) VALUES (?, ?, ?, ?)", wid, Player.uuid, Player.name, n)
    Player.send_message("<green>✔ <white>Rated " + name + " " + n + " star(s).")
end

def cmd_lock():
    name = Cmd.arg("name")
    if !warp_exists(name):
        Player.send_message("<red>✘ <white>No warp named '" + name + "'.")
        return
    end
    if !can_manage(name):
        Player.send_message("<red>✘ <white>You don't own that warp.")
        return
    end
    row = warp_row(name)
    if int(row.get("locked")) == 1:
        SQL.execute("UPDATE warps SET locked = 0 WHERE id = ?", row.get("id"))
        Player.send_message("<green>✔ <white>" + name + " is now public.")
    else:
        SQL.execute("UPDATE warps SET locked = 1 WHERE id = ?", row.get("id"))
        Player.send_message("<yellow>" + name + " is now locked (hidden from the browser).")
    end
end

def cmd_reset():
    name = Cmd.arg("name")
    if !warp_exists(name):
        Player.send_message("<red>✘ <white>No warp named '" + name + "'.")
        return
    end
    if !can_manage(name):
        Player.send_message("<red>✘ <white>You don't own that warp.")
        return
    end
    loc = Player.location
    SQL.execute("UPDATE warps SET world = ?, x = ?, y = ?, z = ? WHERE id = ?",
        loc.world.name, loc.x, loc.y, loc.z, warp_id(name))
    Player.send_message("<green>✔ <white>Moved '" + name + "' to your current location.")
end

def cmd_rename():
    old_name = Cmd.arg("name")
    if !warp_exists(old_name):
        Player.send_message("<red>✘ <white>No warp named '" + old_name + "'.")
        return
    end
    if !can_manage(old_name):
        Player.send_message("<red>✘ <white>You don't own that warp.")
        return
    end
    new_name = sanitize(Cmd.arg("new_name"))
    if new_name == "" || warp_exists(new_name):
        Player.send_message("<red>✘ <white>Could not rename that warp.")
        return
    end
    SQL.execute("UPDATE warps SET name = ? WHERE id = ?", new_name, warp_id(old_name))
    Player.send_message("<green>✔ <white>Renamed to '" + new_name + "'.")
end

def cmd_setowner():
    name = Cmd.arg("name")
    if !warp_exists(name):
        Player.send_message("<red>✘ <white>No warp named '" + name + "'.")
        return
    end
    if !can_manage(name):
        Player.send_message("<red>✘ <white>You don't own that warp.")
        return
    end
    target = Cmd.arg("player")
    SQL.execute("UPDATE warps SET owner_uuid = ?, owner_name = ? WHERE id = ?", target.uuid, target.name, warp_id(name))
    Player.send_message("<green>✔ <white>Transferred " + name + " to " + target.name + ".")
end

def cmd_ban_set():
    name = Cmd.arg("name")
    if !warp_exists(name):
        Player.send_message("<red>✘ <white>No warp named '" + name + "'.")
        return
    end
    if !can_manage(name):
        Player.send_message("<red>✘ <white>You don't own that warp.")
        return
    end
    target = Cmd.arg("player")
    wid = warp_id(name)
    SQL.execute("DELETE FROM warp_bans WHERE warp_id = ? AND uuid = ?", wid, target.uuid)
    SQL.execute("INSERT INTO warp_bans (warp_id, uuid, name) VALUES (?, ?, ?)", wid, target.uuid, target.name)
    Player.send_message("<green>✔ <white>Banned " + target.name + " from " + name + ".")
end

# Target is a plain string (not a "player" arg) so an OFFLINE player already banned can still be
# unbanned by name — matching against the name stored on the ban row itself, since that's the only
# record of them this table keeps.
def cmd_ban_remove():
    name = Cmd.arg("name")
    if !warp_exists(name):
        Player.send_message("<red>✘ <white>No warp named '" + name + "'.")
        return
    end
    if !can_manage(name):
        Player.send_message("<red>✘ <white>You don't own that warp.")
        return
    end
    player_name = Cmd.arg("player")
    wid = warp_id(name)
    rows = SQL.query("SELECT uuid, name FROM warp_bans WHERE warp_id = ? AND lower(name) = ?", wid, lower(player_name))
    if len(rows) <= 0:
        Player.send_message("<red>✘ <white>" + player_name + " isn't banned from that warp.")
        return
    end
    SQL.execute("DELETE FROM warp_bans WHERE warp_id = ? AND uuid = ?", wid, rows.get(0).get("uuid"))
    Player.send_message("<green>✔ <white>Unbanned " + rows.get(0).get("name") + ".")
end

def cmd_favourite():
    name = Cmd.arg("name")
    if !warp_exists(name):
        Player.send_message("<red>✘ <white>No warp named '" + name + "'.")
        return
    end
    toggle_favourite(name)
end

# ---- Admin-only (hidden from a player without the node at all — see cmds/warps.json's
# "permission" field on these three; the has_permission check here is just defense-in-depth). -----

def cmd_removeall():
    if !Player.has_permission(PERM_ADMIN_REMOVEALL):
        Player.send_message("<red>✘ <white>You don't have permission to do that.")
        return
    end
    player_name = Cmd.arg("player")
    target = Server.get_player(player_name)
    if !is_empty(target):
        n = len(SQL.query("SELECT id FROM warps WHERE owner_uuid = ?", target.uuid))
        SQL.execute("DELETE FROM warps WHERE owner_uuid = ?", target.uuid)
    else:
        n = len(SQL.query("SELECT id FROM warps WHERE lower(owner_name) = ?", lower(player_name)))
        SQL.execute("DELETE FROM warps WHERE lower(owner_name) = ?", lower(player_name))
    end
    Player.send_message("<green>✔ <white>Removed " + n + " warp(s) owned by " + player_name + ".")
end

def cmd_reload():
    if !Player.has_permission(PERM_ADMIN_RELOAD):
        Player.send_message("<red>✘ <white>You don't have permission to do that.")
        return
    end
    Server.exec_command("cepolyfill reload scripts")
    Server.exec_command("cepolyfill reload cmds")
    Player.send_message("<green>✔ <white>Reloaded warps scripts/commands.")
end

def cmd_addwarps():
    if !Player.has_permission(PERM_ADMIN_ADDWARPS):
        Player.send_message("<red>✘ <white>You don't have permission to do that.")
        return
    end
    target = Cmd.arg("player")
    n = int(Cmd.arg("amount"))
    target.set_typed("warps_extra_slots", "int", target.get_typed("warps_extra_slots", "int") + n)
    Player.send_message("<green>✔ <white>Gave " + target.name + " " + n + " extra warp slot(s).")
end
