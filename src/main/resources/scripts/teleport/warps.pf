    if offset > 0:
        Player.set_typed("warps_favourite_offset", "int", offset - 1)
    end
    Cmd.open_page("favourite")
end

def next_favourite_page():
    offset = Player.get_typed("warps_favourite_offset", "int")
    if offset < max_favourite_offset():
        Player.set_typed("warps_favourite_offset", "int", offset + 1)
    end
    Cmd.open_page("favourite")
end

def toggle_favourite(name):
    wid = warp_id(name)
    was_fav = is_favourite(name)
    if was_fav:
        SQL.execute("DELETE FROM warp_favourites WHERE warp_id = ? AND player_uuid = ?", wid, Player.uuid)
        Player.send_message("<yellow>Removed <white>" + name + " <yellow>from favourites.")
    else:
        SQL.execute("INSERT INTO warp_favourites (warp_id, player_uuid) VALUES (?, ?)", wid, Player.uuid)
        Player.send_message("<green>Added <white>" + name + " <green>to favourites.")
    end
end

# ---- managewarp.yml -> cml:player_warps_manage: single-warp control panel --------------------

def current_warp():
    return Player.get_typed("warps_current_warp", "string")
end

def managewarp_title():
    name = current_warp()
    locked = int(warp_row(name).get("locked")) == 1
    state_img = "cml:pwarp_setting_enabled"
    if locked:
        state_img = "cml:pwarp_setting_disabled"
    end
    # Source (managewarp.yml): %nexo_shift_-8%%nexo_playerwarps_manage%%nexo_shift_-170%<state
    # icon>%nexo_shift_-58%<title text> — MenuText#shiftOnly/imageTitle chain this project's
    # offset_chars.yml glyphs (neg_1..16, neg_32/48/64/128/256) to hit exact arbitrary magnitudes,
    # so these match the source pack's pixel offsets precisely, not just the right direction.
    return "{Images.from('cml:player_warps_manage')}{Images.from('" + state_img + "', -129)}{Images.shift(-71)}<black> Manage > " + name
end

def mw_teleport():
    teleport_to_warp(current_warp())
end

def mw_open_desc_dialog():
    name = current_warp()
    Dialog.base("Warp Description").input_text("value", "Description", warp_row(name).get("desc")).as_notice(Cmd, "Set", "warps.pf:on_desc_submit").show(Player)
end

def on_desc_submit(value):
    name = current_warp()
    if !is_owner(name):
        return
    end
    SQL.execute("UPDATE warps SET desc = ? WHERE id = ?", sanitize(value), warp_id(name))
    Player.send_message("<green>✔ <white>Description updated.")
end

def mw_toggle_lock():
    name = current_warp()
    if !is_owner(name):
        return
    end
    data = warp_row(name)
    if int(data.get("locked")) == 1:
        SQL.execute("UPDATE warps SET locked = 0 WHERE id = ?", data.get("id"))
        Player.send_message("<green>✔ <white>" + name + " is now public.")
    else:
        SQL.execute("UPDATE warps SET locked = 1 WHERE id = ?", data.get("id"))
        Player.send_message("<yellow>" + name + " is now locked (hidden from the browser).")
    end
    Cmd.open_page("managewarp")
end

def mw_open_category_dialog():
    name = current_warp()
    if MenuClick.click_type == "right":
        SQL.execute("UPDATE warps SET category = 'other' WHERE id = ?", warp_id(name))
        Player.send_message("<yellow>Category removed (reset to 'other').")
        return
    end
    Dialog.base("Warp Category").input_text("value", "Category", warp_row(name).get("category")).as_notice(Cmd, "Set", "warps.pf:on_category_submit").show(Player)
end

def on_category_submit(value):
    name = current_warp()
    if !is_owner(name):
        return
    end
    cat = sanitize(value)
    if cat == "":
        cat = "other"
    end
    SQL.execute("UPDATE warps SET category = ? WHERE id = ?", lower(cat), warp_id(name))
    Player.send_message("<green>✔ <white>Category set to '" + cat + "'.")
end

def mw_open_ban_dialog():
    Dialog.base("Ban Player").input_text("value", "Player Name", "").as_notice(Cmd, "Ban", "warps.pf:on_ban_submit").show(Player)
end

def on_ban_submit(value):
    name = current_warp()
    if !is_owner(name):
        return
    end
    target_name = sanitize(value)
    target = Server.get_player(target_name)
    if is_empty(target):
        Player.send_message("<red>✘ <white>" + target_name + " is not online.")
        return
    end
    wid = warp_id(name)
    SQL.execute("DELETE FROM warp_bans WHERE warp_id = ? AND uuid = ?", wid, target.uuid)
    SQL.execute("INSERT INTO warp_bans (warp_id, uuid, name) VALUES (?, ?, ?)", wid, target.uuid, target.name)
    Player.send_message("<green>✔ <white>Banned " + target.name + " from " + name + ".")
end

def mw_set_icon():
    name = current_warp()
    if !is_owner(name):
        return
    end
    held = Player.main_hand
    if is_empty(held):
        Player.send_message("<red>✘ <white>Hold an item first.")
        return
    end
    SQL.execute("UPDATE warps SET icon = ? WHERE id = ?", held.id, warp_id(name))
    Player.send_message("<green>✔ <white>Icon updated.")
end

