# Rotational Bearing — tick script. The opposite of the Windmill Bearing: instead of GENERATING
# rpm/su from sails, this bearing CONSUMES rpm/su fed into it from below and uses that rpm to spin
# whatever glued structure is attached to its face — Create's actual Mechanical Bearing, as opposed
# to the Windmill Bearing's self-powered one.
#
# Direction follows the incoming network's sign directly (no manual flip like windmill_dir — the
# network already encodes which way it's turning, there's no ambiguity to resolve here).
#
# SU cost: floor(contraption.weight / 5) — a heavier attached structure costs more network capacity
# to keep turning, same idea as Create's stress-per-block for a rotating attachment. `weight` sums
# WeightBlockBehavior.weightOf() over every block in the structure (see ContraptionType#weight).

def _stop():
    Machine.report_su(0)
end

# The world axis the bearing turns about: the axis it FACES (same as windmill.pf's _spin_axis —
# a bearing on the ground faces up and turns flat (Y); one on a wall turns like a wheel (X or Z)).
def _spin_axis():
    if Machine.facing_dy != 0:
        return "y"
    end
    if Machine.facing_dx != 0:
        return "x"
    end
    return "z"
end

def status():
    return Machine.get_flag("assembled") > 0 && rpm != 0 ? "true" : "false"
end

def on_break():
    _stop()
end

# ---- tick ---------------------------------------------------------------

if Machine.get_flag("assembled") <= 0:
    _stop()
    return
end

contraption = Machine.contraption

if contraption == null:
    # The contraption is gone (broken, unloaded past recovery): forget it and stop.
    Machine.set_flag("assembled", 0)
    Machine.set_str_flag("contraption_uuid", "")
    _stop()
    return
end

# tick() (MinecraftServer's absolute tick counter) resets to 0 on every server restart, but
# "assembled_tick" is a PERSISTED flag stamped at assembly time under the previous session's
# tick count — after a restart, tick() < assembled_tick until it naturally grows back past the
# old value (which could take hours), leaving the head-cap renderer's
# (tick() - assembled_tick) epoch desynced from the contraption's own rotation the whole time.
# Re-stamp the instant we detect the counter went backwards: cheap (one comparison/tick) and
# self-heals on the very first tick after reconnecting, restart or not.
if tick() < Machine.get_flag("assembled_tick"):
    Machine.set_flag("assembled_tick", tick())
end

if rpm == 0:
    # Nothing feeding the bearing right now — hold still, don't charge for it.
    contraption.set_spin(_spin_axis(), 0)
    _stop()
    return
end

su = floor(contraption.weight / 5)

if Machine.is_overstressed:
    # The network can't actually cover this load: stall instead of spinning for free.
    contraption.set_spin(_spin_axis(), 0)
    Machine.report_su(su)
    return
end

contraption.set_spin(_spin_axis(), rpm)
Machine.report_su(su)
